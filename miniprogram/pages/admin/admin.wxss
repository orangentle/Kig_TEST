/* admin.wxss */
.admin-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* 顶部 */
.top-bar {
  padding: 28rpx 28rpx 20rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, #ff8800 0%, #ffa733 60%, #ffc266 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-title { display: flex; flex-direction: column; }
.brand { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.sub { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

.icon-btn {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
}

/* 概览卡 */
.stats-scroll {
  background: linear-gradient(180deg, #ffa733 0%, #ffa733 50%, var(--color-bg) 50%, var(--color-bg) 100%);
  padding: 4rpx 0 12rpx;
}

.stats-row {
  display: inline-flex;
  padding: 8rpx 24rpx 12rpx;
  gap: 16rpx;
  white-space: nowrap;
}

.stat-card {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 160rpx;
  padding: 20rpx 22rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-text);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.stat-card.total .stat-num { color: var(--color-primary); }
.stat-card.pending .stat-num { color: #faad14; }
.stat-card.urgent .stat-num { color: #ff4d4f; }
.stat-card.overdue .stat-num { color: #ff4d4f; }
.stat-card.completed .stat-num { color: #52c41a; }
.stat-card.archived .stat-num { color: #8a8a8a; }
.stat-card.processing .stat-num { color: #1890ff; }

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 12rpx;
  gap: 8rpx;
}

.search-wrap { flex: 1; min-width: 0; }

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 12rpx;
  font-size: 20rpx;
  color: #666;
  background: #fff;
  border-radius: 16rpx;
  min-width: 80rpx;
  box-shadow: var(--shadow-sm);
}

.tool-btn text { margin-top: 2rpx; }

.tool-btn.tool-active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

/* 阶段 tab */
.tabs-scroll {
  padding: 8rpx 0 16rpx;
}

.tabs-row {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.tab-chip {
  padding: 10rpx 24rpx;
  background: #fff;
  color: #5a5a5a;
  font-size: 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.tab-chip-active {
  background: linear-gradient(135deg, #ff8800, #ffaa33);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 136, 0, 0.3);
}

/* 列表头信息 */
.list-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 28rpx 12rpx;
}

.list-total {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.list-select-all {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 0 24rpx 160rpx;
  box-sizing: border-box;
}

.loading-block,
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  gap: 12rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.empty-block { padding: 120rpx 0; }

.order-card {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: all 0.2s ease;
}

.order-card:active { transform: scale(0.99); }

.card-selected {
  background: #fff8f0;
  box-shadow: 0 0 0 2rpx var(--color-primary), var(--shadow-md);
}

.card-stripe {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
}

.stripe-normal { background: #d0d0d0; }
.stripe-urgent { background: #ff4d4f; }
.stripe-pending { background: #faad14; }
.stripe-completed { background: #52c41a; }

.card-urgent {
  background: linear-gradient(90deg, #fff5f5 0%, #fff 30%);
}

.card-check {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.check-box {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d0d0d0;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
}

.check-box-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.card-body { flex: 1; min-width: 0; }

.card-row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.status-pill {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
  white-space: nowrap;
}

.pill-normal { background: var(--color-primary-bg); color: var(--color-primary); }
.pill-urgent { background: #fff1f0; color: #ff4d4f; }
.pill-pending { background: #fffbe6; color: #faad14; }
.pill-completed { background: #f0faf3; color: #52c41a; }

.card-row-2 {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.customer { font-weight: 500; }
.dot-sep { margin: 0 10rpx; color: var(--color-text-tertiary); }
.tb-id { color: var(--color-text-tertiary); font-size: 22rpx; }

.card-row-3 { margin-bottom: 10rpx; }

.progress-mini {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-mini-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-mini-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff8800, #ffcc33);
  border-radius: 999rpx;
}

.progress-mini-num {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
  min-width: 60rpx;
  text-align: right;
}

.card-row-4 {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 批量操作栏 */
.batch-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.1);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.batch-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.batch-clear {
  color: var(--color-primary);
  font-weight: 500;
}

.batch-actions { padding-bottom: 16rpx; }

.batch-row {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.batch-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 14rpx 22rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  min-width: 120rpx;
  flex-shrink: 0;
}

.batch-btn text { margin-top: 6rpx; }
.batch-btn:active { background: #efeff2; }

/* 弹窗面板 */
.popup-panel {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  padding: 8rpx 32rpx 20rpx;
  color: var(--color-text);
}

.popup-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.popup-row:active { background: #f7f8fa; }

.popup-row-active {
  color: var(--color-primary);
  font-weight: 600;
}

.popup-row-meta {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

/* 筛选 */
.filter-panel {
  width: 600rpx;
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid var(--color-divider);
}

.filter-title { font-size: 32rpx; font-weight: 700; }

.filter-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.filter-group { margin-bottom: 28rpx; }

.filter-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

.filter-picker {
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.filter-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
}

.filter-footer t-button { flex: 1; }

/* 操作抽屉 */
.action-sheet {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding-top: 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid var(--color-divider);
}

.action-row text { margin-left: 20rpx; }
.action-row:active { background: #f7f8fa; }

.action-cancel {
  margin: 16rpx 32rpx 0;
  text-align: center;
  padding: 24rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 新增订单表单 */
.form-popup {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.form-title { font-size: 32rpx; font-weight: 700; }

.form-body {
  padding: 24rpx 32rpx;
  max-height: 60vh;
}

.form-item { margin-bottom: 24rpx; }

.form-row-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

.required { color: #ff4d4f; }

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.image-uploader {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d0d0d0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  overflow: hidden;
}

.preview-img { width: 100%; height: 100%; }

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--color-text-tertiary);
}

.upload-icon { font-size: 56rpx; line-height: 1; }
.upload-text { font-size: 22rpx; margin-top: 8rpx; }

.form-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
}

.form-footer t-button { flex: 1; }
