/* admin.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header-gradient {
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  padding: 24rpx;
  color: white;
}

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-logo {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.admin-avatar-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.admin-title {
  font-size: 32rpx;
  font-weight: 500;
}

.admin-info {
  display: flex;
  align-items: center;
}

.admin-name {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.filter-tabs {
  background-color: white;
  padding: 24rpx;
}

.tabs-container {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 8rpx;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.tab-active {
  color: #ff8800;
  border-bottom: 4rpx solid #ff8800;
  font-weight: 500;
}

.search-container {
  padding: 24rpx;
  background-color: white;
  border-top: 2rpx solid #f5f5f5;
  border-bottom: 2rpx solid #f5f5f5;
}

.order-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.order-card {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-card-urgent {
  border-left: 8rpx solid #ff4d4f;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-weight: 500;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-info {
  flex: 1;
}

.order-customer, .order-role {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.order-role {
  color: #999;
}

.order-progress {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.progress-bar {
  width: 120rpx;
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  border-radius: 8rpx;
}

.order-action {
  color: #ff8800;
  font-size: 28rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.footer-actions {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background-color: white;
  border-top: 2rpx solid #f5f5f5;
}

.action-button {
  flex: 1;
  margin: 0 8rpx;
} 