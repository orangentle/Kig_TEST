/* admin.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header-gradient {
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  padding: 24rpx;
  color: white;
}

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-logo {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.admin-avatar-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.admin-title {
  font-size: 32rpx;
  font-weight: 500;
}

.admin-info {
  display: flex;
  align-items: center;
}

.admin-name {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.filter-tabs {
  background-color: white;
  padding: 24rpx;
}

.tabs-container {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 8rpx;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.tab-active {
  color: #ff8800;
  border-bottom: 4rpx solid #ff8800;
  font-weight: 500;
}

.search-container {
  padding: 24rpx;
  background-color: white;
  border-top: 2rpx solid #f5f5f5;
  border-bottom: 2rpx solid #f5f5f5;
}

.order-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.order-card {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-card-urgent {
  border-left: 8rpx solid #ff4d4f;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-weight: 500;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-info {
  flex: 1;
}

.order-customer, .order-role {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.order-role {
  color: #999;
}

.order-progress {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.progress-bar {
  width: 120rpx;
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  border-radius: 8rpx;
}

.order-action {
  color: #ff8800;
  font-size: 28rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.footer-actions {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background-color: white;
  border-top: 2rpx solid #f5f5f5;
}

.action-button {
  flex: 1;
  margin: 0 8rpx;
}

/* 新增订单表单样式 */
.order-form-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.order-form-modal.show {
  opacity: 1;
  visibility: visible;
}

.order-form-content {
  width: 90%;
  max-width: 650rpx;
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 90vh;
}

.form-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-title {
  font-size: 32rpx;
  font-weight: 500;
}

.form-close {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.form-body {
  padding: 24rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #333;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.image-uploader {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 24rpx;
  text-align: center;
  padding: 4rpx 0;
}

.form-footer {
  padding: 24rpx;
  display: flex;
  justify-content: flex-end;
  border-top: 2rpx solid #f5f5f5;
}

.form-button {
  margin-left: 16rpx;
  min-width: 160rpx;
}

.status-urgent {
  background-color: #ff4d4f;
  color: white;
}

.status-soon {
  background-color: #faad14;
  color: white;
}

.status-normal {
  background-color: #52c41a;
  color: white;
} 