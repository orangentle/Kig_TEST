<!--admin.wxml - 管理后台 -->
<view class="admin-page">
  <!-- 顶部 -->
  <view class="top-bar">
    <view class="top-title">
      <text class="brand">鼠鼠工坊</text>
      <text class="sub">管理后台</text>
    </view>
    <view class="top-actions">
      <view class="icon-btn" bindtap="onOpenAddSheet">
        <t-icon name="add" size="44rpx" color="#fff" />
      </view>
    </view>
  </view>

  <!-- 概览卡 -->
  <scroll-view scroll-x class="stats-scroll" enhanced show-scrollbar="{{false}}">
    <view class="stats-row">
      <view class="stat-card total" data-key="total" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-label">订单总数</text>
      </view>
      <view class="stat-card pending" data-key="pending" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.pending}}</text>
        <text class="stat-label">待审核</text>
      </view>
      <view class="stat-card processing" data-key="processing" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.processing}}</text>
        <text class="stat-label">制作中</text>
      </view>
      <view class="stat-card urgent" data-key="urgent" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.urgent}}</text>
        <text class="stat-label">加急</text>
      </view>
      <view class="stat-card overdue" data-key="overdue" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.overdue}}</text>
        <text class="stat-label">已逾期</text>
      </view>
      <view class="stat-card completed" data-key="completed" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-card archived" data-key="archived" bindtap="onStatCardTap">
        <text class="stat-num">{{stats.archived}}</text>
        <text class="stat-label">已归档</text>
      </view>
    </view>
  </scroll-view>

  <!-- 搜索 + 工具栏 -->
  <view class="toolbar">
    <view class="search-wrap">
      <t-search
        value="{{searchValue}}"
        placeholder="订单号/客户/角色"
        bind:change="onSearchChange"
        bind:submit="onSearchSubmit"
        bind:clear="onSearchClear"
      />
    </view>
    <view class="tool-btn" bindtap="openSortPopup">
      <t-icon name="order-ascending" size="36rpx" color="#666" />
      <text>排序</text>
    </view>
    <view class="tool-btn" bindtap="openFilterPopup">
      <t-icon name="filter" size="36rpx" color="#666" />
      <text>筛选</text>
    </view>
    <view class="tool-btn {{selectionMode ? 'tool-active' : ''}}" bindtap="onToggleSelectionMode">
      <t-icon name="check" size="36rpx" color="{{selectionMode ? '#ff8800' : '#666'}}" />
      <text>{{selectionMode ? '退出' : '多选'}}</text>
    </view>
  </view>

  <!-- 阶段标签 -->
  <scroll-view scroll-x class="tabs-scroll" enhanced show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-chip {{currentTab === item.key ? 'tab-chip-active' : ''}}"
        data-tab="{{item.key}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 列表头部信息 -->
  <view class="list-meta">
    <text class="list-total">共 {{total}} 条</text>
    <view wx:if="{{selectionMode}}" class="list-select-all" bindtap="onSelectAllCurrent">
      <text>{{selectedIds.length === orders.length && orders.length > 0 ? '取消全选' : '全选本页'}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view
    scroll-y
    class="order-list"
    bindscrolltolower="onScrollToLower"
    lower-threshold="200"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{isLoading}}" class="loading-block">
      <t-loading theme="circular" size="40rpx" /><text>加载中...</text>
    </view>

    <block wx:elif="{{orders.length > 0}}">
      <view
        wx:for="{{orders}}"
        wx:key="_id"
        class="order-card {{item.isUrgent ? 'card-urgent' : ''}} {{selectedSet[item._id] ? 'card-selected' : ''}}"
        data-id="{{item._id}}"
        data-tb-id="{{item.tbOrderId}}"
        bindtap="onOrderTap"
        bindlongpress="onOrderLongPress"
      >
        <!-- 左侧色条 -->
        <view class="card-stripe stripe-{{item.isUrgent ? 'urgent' : item.status === 'completed' ? 'completed' : item.status === 'pending' ? 'pending' : 'normal'}}"></view>

        <!-- 复选框 -->
        <view wx:if="{{selectionMode}}" class="card-check">
          <view class="check-box {{selectedSet[item._id] ? 'check-box-on' : ''}}">
            <t-icon wx:if="{{selectedSet[item._id]}}" name="check" size="28rpx" color="#fff" />
          </view>
        </view>

        <!-- 内容 -->
        <view class="card-body">
          <view class="card-row-1">
            <text class="role-name">{{item.roleName || '未命名'}}</text>
            <view class="pill-group">
              <view wx:if="{{item.isUrgent}}" class="status-pill pill-urgent">加急</view>
              <view class="status-pill {{item.status === 'completed' ? 'pill-completed' : item.status === 'pending' ? 'pill-pending' : 'pill-normal'}}">
                {{item.status === 'completed' ? '已完成' : item.status === 'pending' ? '待审核' : item.progressStage || '进行中'}}
              </view>
            </view>
          </view>
          <view class="card-row-2">
            <text class="customer">{{item.customerName || '未填客户'}}</text>
            <text class="dot-sep">·</text>
            <text class="tb-id">{{item.tbOrderId}}</text>
          </view>
          <view class="card-row-3">
            <view class="progress-mini">
              <view class="progress-mini-bar">
                <view class="progress-mini-fill" style="width:{{item.progressPercent}}%"></view>
              </view>
              <text class="progress-mini-num">{{item.progressPercent}}%</text>
            </view>
          </view>
          <view class="card-row-4">
            <text class="meta-text">下单 {{item.orderTime}}</text>
            <text class="meta-text">截止 {{item.deadline}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{isLoadingMore}}" class="loading-more">
        <t-loading theme="circular" size="32rpx" /><text>加载更多...</text>
      </view>
      <view wx:elif="{{!hasMore && orders.length > 0}}" class="no-more">已显示全部</view>
    </block>

    <view wx:else class="empty-block">
      <t-empty description="暂无订单" />
    </view>
  </scroll-view>

  <!-- 批量操作栏 -->
  <view wx:if="{{selectionMode && selectedIds.length > 0}}" class="batch-bar">
    <view class="batch-info">
      <text>已选 {{selectedIds.length}} 条</text>
      <text class="batch-clear" bindtap="onClearSelection">清空</text>
    </view>
    <scroll-view scroll-x class="batch-actions" enhanced show-scrollbar="{{false}}">
      <view class="batch-row">
        <block wx:if="{{currentTab === 'pending'}}">
          <view class="batch-btn batch-btn-primary" bindtap="onBatchApprove">
            <t-icon name="check-circle" size="32rpx" color="#52c41a" /><text>审核通过</text>
          </view>
          <view class="batch-btn batch-btn-danger" bindtap="onBatchReject">
            <t-icon name="close-circle" size="32rpx" color="#ff4d4f" /><text>驳回</text>
          </view>
        </block>
        <view class="batch-btn" bindtap="onBatchAdvance">
          <t-icon name="arrow-right" size="32rpx" color="#ff8800" /><text>推进阶段</text>
        </view>
        <view class="batch-btn" bindtap="onBatchSetStageOpen">
          <t-icon name="precise-monitor" size="32rpx" color="#ff8800" /><text>设为阶段</text>
        </view>
        <view class="batch-btn" bindtap="onBatchMarkUrgent">
          <t-icon name="error-circle" size="32rpx" color="#ff4d4f" /><text>设加急</text>
        </view>
        <view class="batch-btn" bindtap="onBatchUnmarkUrgent">
          <t-icon name="close-circle" size="32rpx" color="#666" /><text>取消加急</text>
        </view>
        <view class="batch-btn" bindtap="onBatchAssignQueue">
          <t-icon name="numbers" size="32rpx" color="#1890ff" /><text>分配排单号</text>
        </view>
        <view class="batch-btn" bindtap="onBatchArchive">
          <t-icon name="folder" size="32rpx" color="#52c41a" /><text>归档</text>
        </view>
        <view class="batch-btn batch-btn-danger" bindtap="onBatchDelete">
          <t-icon name="delete" size="32rpx" color="#cf1322" /><text>删除</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 排序弹窗 -->
  <t-popup visible="{{showSortPopup}}" placement="bottom" bind:visible-change="closeSortPopup">
    <view class="popup-panel">
      <view class="popup-title">排序方式</view>
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="popup-row {{(sortBy + '-' + sortOrder) === item.key ? 'popup-row-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortPick"
      >
        <text>{{item.label}}</text>
        <t-icon wx:if="{{(sortBy + '-' + sortOrder) === item.key}}" name="check" color="#ff8800" size="36rpx" />
      </view>
    </view>
  </t-popup>

  <!-- 批量设置阶段弹窗 -->
  <t-popup visible="{{showBatchStagePopup}}" placement="bottom" bind:visible-change="onBatchSetStageClose">
    <view class="popup-panel">
      <view class="popup-title">设置阶段（{{selectedIds.length}} 条）</view>
      <view
        wx:for="{{stageOptions}}"
        wx:key="value"
        class="popup-row"
        data-value="{{item.value}}"
        bindtap="onBatchSetStagePick"
      >
        <text>{{item.label}}</text>
        <text class="popup-row-meta">{{item.percent}}%</text>
      </view>
    </view>
  </t-popup>

  <!-- 筛选弹窗 -->
  <t-popup visible="{{showFilterPopup}}" placement="right" bind:visible-change="closeFilterPopup">
    <view class="filter-panel">
      <view class="filter-header">
        <text class="filter-title">筛选</text>
        <t-icon name="close" size="48rpx" color="#999" bindtap="closeFilterPopup" />
      </view>
      <view class="filter-body">
        <view class="filter-group">
          <view class="filter-label">下单日期 起</view>
          <picker mode="date" value="{{dateFrom}}" bindchange="onFilterDateFromChange">
            <view class="filter-picker">{{dateFrom || '请选择'}}</view>
          </picker>
        </view>
        <view class="filter-group">
          <view class="filter-label">下单日期 止</view>
          <picker mode="date" value="{{dateTo}}" bindchange="onFilterDateToChange">
            <view class="filter-picker">{{dateTo || '请选择'}}</view>
          </picker>
        </view>
        <view class="filter-group filter-toggle" bindtap="onToggleIncludeArchived">
          <text>包含已归档</text>
          <switch checked="{{includeArchived}}" color="#ff8800" disabled />
        </view>

        <view class="danger-zone">
          <view class="danger-title">危险操作</view>
          <view class="danger-desc">仅清理测试数据：删除 queueNumber 以 RatStudio-2026- 开头的订单</view>
          <view class="danger-btn danger-btn--mock" bindtap="onClearMockOrders">清理测试数据</view>
        </view>
      </view>
      <view class="filter-footer">
        <t-button variant="outline" size="large" bind:tap="onResetFilter">重置</t-button>
        <t-button theme="primary" size="large" class="primary-button" hover-class="primary-button-hover" hover-stay-time="80" bind:tap="onApplyFilter">应用</t-button>
      </view>
    </view>
  </t-popup>

  <!-- 新增/管理 抽屉 -->
  <t-popup visible="{{showAddSheet}}" placement="bottom" bind:visible-change="onCloseAddSheet">
    <view class="action-sheet">
      <view class="action-row" bindtap="onAddOrder">
        <t-icon name="add-circle" size="44rpx" color="#ff8800" />
        <text>新增订单</text>
      </view>
      <view class="action-row" bindtap="onOrderReview">
        <t-icon name="task-checked" size="44rpx" color="#1890ff" />
        <text>订单审核</text>
      </view>
      <view class="action-row" bindtap="onManageWorks">
        <t-icon name="image" size="44rpx" color="#52c41a" />
        <text>作品管理</text>
      </view>
      <view class="action-row" bindtap="onExport">
        <t-icon name="download" size="44rpx" color="#666" />
        <text>导出数据</text>
      </view>
      <view class="action-cancel" bindtap="onCloseAddSheet">取消</view>
    </view>
  </t-popup>

  <!-- 新增订单表单 -->
  <t-popup visible="{{showOrderForm}}" placement="bottom" bind:visible-change="onCloseOrderForm">
    <view class="form-popup">
      <view class="form-header">
        <text class="form-title">新增订单</text>
        <t-icon name="close" size="48rpx" color="#999" bindtap="onCloseOrderForm" />
      </view>
      <scroll-view scroll-y class="form-body">

        <!-- 区块：基本信息 -->
        <view class="form-section">
          <view class="form-section-title">基本信息</view>
          <view class="form-item">
            <text class="form-label">淘宝订单号 <text class="required">*</text></text>
            <input class="form-input" placeholder="请输入" value="{{orderForm.tbOrderId}}" data-field="tbOrderId" bindinput="onFormInputChange" />
          </view>
          <view class="form-item">
            <text class="form-label">排单号</text>
            <input class="form-input" placeholder="可后续批量分配" value="{{orderForm.queueNumber}}" data-field="queueNumber" bindinput="onFormInputChange" />
          </view>
          <view class="form-item">
            <text class="form-label">客户名称 <text class="required">*</text></text>
            <input class="form-input" placeholder="请输入" maxlength="20" value="{{orderForm.customerName}}" data-field="customerName" bindinput="onFormInputChange" />
          </view>
          <view class="form-item">
            <text class="form-label">角色名称 <text class="required">*</text></text>
            <input class="form-input" placeholder="请输入" maxlength="30" value="{{orderForm.roleName}}" data-field="roleName" bindinput="onFormInputChange" />
          </view>
          <view class="form-item">
            <text class="form-label">角色出处 IP</text>
            <input class="form-input" placeholder="如：原神、崩坏3..." maxlength="30" value="{{orderForm.ip}}" data-field="ip" bindinput="onFormInputChange" />
          </view>
        </view>

        <!-- 区块：联系方式 -->
        <view class="form-section">
          <view class="form-section-title">联系方式</view>
          <view class="form-item">
            <text class="form-label">淘宝旺旺</text>
            <input class="form-input" placeholder="选填" maxlength="30" value="{{orderForm.taobaoName}}" data-field="taobaoName" bindinput="onFormInputChange" />
          </view>
          <view class="form-row-2">
            <view class="form-item form-col">
              <text class="form-label">QQ</text>
              <input class="form-input" type="number" placeholder="选填" maxlength="11" value="{{orderForm.qq}}" data-field="qq" bindinput="onFormInputChange" />
            </view>
            <view class="form-item form-col">
              <text class="form-label">手机号</text>
              <input class="form-input" type="number" placeholder="选填" maxlength="11" value="{{orderForm.phone}}" data-field="phone" bindinput="onFormInputChange" />
            </view>
          </view>
        </view>

        <!-- 区块：身材数据 -->
        <view class="form-section">
          <view class="form-section-title">身材数据</view>
          <view class="form-row-2">
            <view class="form-item form-col">
              <text class="form-label">身高 cm <text class="required">*</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{orderForm.height}}" data-field="height" bindinput="onFormNumberChange" />
            </view>
            <view class="form-item form-col">
              <text class="form-label">头围 cm <text class="required">*</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{orderForm.headCircumference}}" data-field="headCircumference" bindinput="onFormNumberChange" />
            </view>
          </view>
          <view class="form-row-2">
            <view class="form-item form-col">
              <text class="form-label">体重 kg</text>
              <input class="form-input" type="digit" placeholder="0" value="{{orderForm.weight}}" data-field="weight" bindinput="onFormNumberChange" />
            </view>
            <view class="form-item form-col">
              <text class="form-label">肩宽 cm</text>
              <input class="form-input" type="digit" placeholder="0" value="{{orderForm.shoulderWidth}}" data-field="shoulderWidth" bindinput="onFormNumberChange" />
            </view>
          </view>
        </view>

        <!-- 区块：定制选项 -->
        <view class="form-section">
          <view class="form-section-title">定制选项</view>
          <view class="form-item form-row-toggle">
            <text class="form-label-inline">需要配饰</text>
            <switch checked="{{orderForm.needAccessory}}" color="#ff8800" data-field="needAccessory" bindchange="onToggleField" />
          </view>
          <view class="form-item form-row-toggle">
            <text class="form-label-inline">需要替换脸</text>
            <switch checked="{{orderForm.needReplaceFace}}" color="#ff8800" data-field="needReplaceFace" bindchange="onToggleField" />
          </view>
          <view wx:if="{{orderForm.needReplaceFace}}" class="form-item">
            <text class="form-label">替换脸数量</text>
            <picker mode="selector" range="{{faceCountOptions}}" value="{{faceCountIndex}}" bindchange="onFaceCountChange">
              <view class="form-picker">{{orderForm.replaceFaceCount}} 张</view>
            </picker>
          </view>
          <view class="form-item form-row-toggle">
            <text class="form-label-inline">加急</text>
            <switch checked="{{orderForm.isUrgent}}" color="#ff4d4f" bindchange="onToggleUrgent" />
          </view>
        </view>

        <!-- 区块：排期与阶段 -->
        <view class="form-section">
          <view class="form-section-title">排期与阶段</view>
          <view class="form-row-2">
            <view class="form-item form-col">
              <text class="form-label">下单日期 <text class="required">*</text></text>
              <picker mode="date" value="{{orderForm.orderTime}}" data-field="orderTime" bindchange="onDateChange">
                <view class="form-picker">{{orderForm.orderTime || '请选择'}}</view>
              </picker>
            </view>
            <view class="form-item form-col">
              <text class="form-label">预期完成 <text class="required">*</text></text>
              <picker mode="date" value="{{orderForm.deadline}}" data-field="deadline" bindchange="onDateChange">
                <view class="form-picker">{{orderForm.deadline || '请选择'}}</view>
              </picker>
            </view>
          </view>
          <view class="form-item">
            <text class="form-label">制作阶段</text>
            <picker mode="selector" range="{{stageOptions}}" range-key="label" value="{{stageIndex}}" bindchange="onStageChange">
              <view class="form-picker">{{orderForm.progressStage}} · {{orderForm.progressPercent}}%</view>
            </picker>
          </view>
        </view>

        <!-- 区块：图片 -->
        <view class="form-section">
          <view class="form-section-title">图片资料</view>
          <view class="form-item">
            <text class="form-label">角色参考图（最多 3 张）</text>
            <view class="img-grid">
              <view wx:for="{{referenceImages}}" wx:key="index" class="img-item">
                <image class="img-thumb" src="{{item}}" mode="aspectFill" />
                <view class="img-remove" data-index="{{index}}" catchtap="onRemoveReferenceImage">
                  <t-icon name="close" size="24rpx" color="#fff" />
                </view>
              </view>
              <view wx:if="{{referenceImages.length < 3}}" class="img-add" bindtap="onChooseReferenceImages">
                <text class="upload-icon">+</text>
              </view>
            </view>
          </view>

          <view wx:if="{{orderForm.needReplaceFace}}" class="form-item">
            <text class="form-label">替换脸图片（{{replaceFaceImages.length}}/{{orderForm.replaceFaceCount}}）</text>
            <view class="img-grid">
              <view wx:for="{{replaceFaceImages}}" wx:key="index" class="img-item">
                <image class="img-thumb" src="{{item}}" mode="aspectFill" />
                <view class="img-remove" data-index="{{index}}" catchtap="onRemoveFaceImage">
                  <t-icon name="close" size="24rpx" color="#fff" />
                </view>
              </view>
              <view wx:if="{{replaceFaceImages.length < orderForm.replaceFaceCount}}" class="img-add" bindtap="onChooseFaceImages">
                <text class="upload-icon">+</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 区块：备注 -->
        <view class="form-section">
          <view class="form-section-title">备注</view>
          <view class="form-item">
            <textarea
              class="form-textarea"
              placeholder="特殊要求 / 客户备注..."
              maxlength="500"
              value="{{orderForm.remark}}"
              data-field="remark"
              bindinput="onFormInputChange"
            />
          </view>
        </view>

      </scroll-view>
      <view class="form-footer">
        <t-button variant="outline" size="large" bind:tap="onCloseOrderForm">取消</t-button>
        <t-button theme="primary" size="large" class="primary-button" hover-class="primary-button-hover" hover-stay-time="80" loading="{{isSubmitting}}" bind:tap="onSubmitOrderForm">提交</t-button>
      </view>
    </view>
  </t-popup>
</view>
