<!--admin.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="header-gradient">
    <view class="admin-header">
      <view class="admin-logo">
        <image class="admin-avatar" src="/assets/images/icon.jpg" mode="aspectFill"></image>
        <text class="admin-title">鼠鼠工坊管理后台</text>
      </view>
      <view class="admin-info">
        <text class="admin-name">管理员</text>
        <image class="admin-avatar-small" src="/assets/images/icon.jpg" mode="aspectFill"></image>
      </view>
    </view>
  </view>
  
  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <scroll-view scroll-x class="tabs-container">
      <view 
        class="tab-item {{currentTab === 'all' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="all"
      >全部未完成 ({{orderCounts.all || 0}})</view>
      <view 
        class="tab-item {{currentTab === 'design' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="design"
      >设计确认 ({{orderCounts.design || 0}})</view>
      <view 
        class="tab-item {{currentTab === 'model' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="model"
      >模型制作 ({{orderCounts.model || 0}})</view>
      <view 
        class="tab-item {{currentTab === 'print' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="print"
      >打印中 ({{orderCounts.print || 0}})</view>
      <view 
        class="tab-item {{currentTab === 'polish' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="polish"
      >打磨上色 ({{orderCounts.polish || 0}})</view>
      <view 
        class="tab-item {{currentTab === 'assembly' ? 'tab-active' : ''}}" 
        bindtap="onTabChange" 
        data-tab="assembly"
      >组装 ({{orderCounts.assembly || 0}})</view>
    </scroll-view>
  </view>
  
  <!-- 搜索框 -->
  <view class="search-container">
    <t-search
      value="{{searchValue}}"
      placeholder="搜索订单号或客户名称"
      bind:change="onSearchChange"
      bind:submit="onSearch"
    />
  </view>
  
  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list">
    <block wx:if="{{filteredOrders.length > 0}}">
      <!-- 按下单时间排序，最早的在顶部 -->
      <view 
        class="order-card {{item.status === 'urgent' ? 'order-card-urgent' : ''}}" 
        wx:for="{{filteredOrders}}" 
        wx:key="orderId"
        bindtap="onOrderClick"
        data-order-id="{{item.orderId}}"
      >
        <view class="order-header">
          <text class="order-id">订单号: {{item.orderId}}</text>
          <view class="order-status {{item.status === 'urgent' ? 'status-urgent' : item.status === 'soon' ? 'status-soon' : 'status-normal'}}">
            {{item.status === 'urgent' ? '加急' : item.status === 'soon' ? '即将完成' : '正常'}}
          </view>
        </view>
        
        <view class="order-content">
          <view class="order-info">
            <view class="order-customer">客户: {{item.customerName}}</view>
            <view class="order-role">角色: {{item.roleName}}</view>
            <view class="order-progress">
              <text class="progress-text">{{item.progressStage}}</text>
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{item.progressPercent}}%; background-color: {{item.status === 'urgent' ? '#ff4d4f' : item.status === 'soon' ? '#faad14' : '#ff8800'}}"></view>
              </view>
            </view>
          </view>
          <view class="order-action">查看详情</view>
        </view>
        
        <view class="order-footer">
          <text class="order-time">下单时间: {{item.orderTime}}</text>
          <text class="order-deadline">预期完成: {{item.deadline}}</text>
        </view>
      </view>
    </block>
    
    <view class="empty-state" wx:else>
      <image class="empty-image" src="/assets/images/icon.jpg" mode="aspectFit"></image>
      <text class="empty-text">暂无相关订单</text>
    </view>
  </scroll-view>
  
  <!-- 底部操作栏 -->
  <view class="footer-actions">
    <t-button 
      icon="add" 
      variant="outline" 
      theme="primary" 
      class="action-button" 
      bind:tap="onAddOrder"
    >新增订单</t-button>
    <t-button 
      icon="upload" 
      variant="outline" 
      theme="primary" 
      class="action-button" 
      bind:tap="onExportData"
    >导出数据</t-button>
    <t-button 
      icon="file-copy" 
      theme="primary" 
      class="action-button primary-button" 
      bind:tap="onViewArchive"
    >查看归档</t-button>
  </view>
  
  <!-- 新增订单表单弹窗 -->
  <view class="order-form-modal {{showOrderForm ? 'show' : ''}}" wx:if="{{showOrderForm}}">
    <view class="order-form-content">
      <view class="form-header">
        <text class="form-title">新增订单</text>
        <view class="form-close" bindtap="onCloseOrderForm">×</view>
      </view>
      
      <scroll-view scroll-y class="form-body">
        <view class="form-item">
          <text class="form-label">淘宝订单号 <text class="required">*</text></text>
          <input 
            class="form-input" 
            placeholder="请输入淘宝订单号" 
            value="{{orderForm.tbOrderId}}" 
            bindinput="onFormInputChange" 
            data-field="tbOrderId"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">排单号</text>
          <input 
            class="form-input" 
            placeholder="请输入排单号" 
            value="{{orderForm.queueNumber}}" 
            bindinput="onFormInputChange" 
            data-field="queueNumber"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">客户名称 <text class="required">*</text></text>
          <input 
            class="form-input" 
            placeholder="请输入客户名称" 
            value="{{orderForm.customerName}}" 
            bindinput="onFormInputChange" 
            data-field="customerName"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">角色名称 <text class="required">*</text></text>
          <input 
            class="form-input" 
            placeholder="请输入角色名称" 
            value="{{orderForm.roleName}}" 
            bindinput="onFormInputChange" 
            data-field="roleName"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">下单时间 <text class="required">*</text></text>
          <picker 
            mode="date" 
            value="{{orderForm.orderTime}}" 
            bindchange="onDateChange" 
            data-field="orderTime"
          >
            <view class="form-picker">
              {{orderForm.orderTime || '请选择下单时间'}}
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">预期完成时间 <text class="required">*</text></text>
          <picker 
            mode="date" 
            value="{{orderForm.deadline}}" 
            bindchange="onDateChange" 
            data-field="deadline"
          >
            <view class="form-picker">
              {{orderForm.deadline || '请选择预期完成时间'}}
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">制作进度</text>
          <slider 
            value="{{orderForm.progressPercent}}" 
            min="0" 
            max="100" 
            show-value 
            activeColor="#ff8800"
            bindchange="onFormInputChange" 
            data-field="progressPercent"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">是否加急</text>
          <switch 
            checked="{{orderForm.isUrgent}}" 
            color="#ff4d4f" 
            bindchange="onToggleUrgent"
          />
        </view>
        
        <view class="form-item">
          <text class="form-label">预期成品展示图</text>
          <view class="image-uploader" bindtap="onChooseImage">
            <block wx:if="{{tempImagePath}}">
              <image class="preview-image" src="{{tempImagePath}}" mode="aspectFit"></image>
              <view class="upload-progress" wx:if="{{uploadProgress > 0 && uploadProgress < 100}}">
                {{uploadProgress}}%
              </view>
            </block>
            <view class="upload-placeholder" wx:else>
              <text class="upload-icon">+</text>
              <text class="upload-text">选择图片</text>
            </view>
          </view>
        </view>
      </scroll-view>
      
      <view class="form-footer">
        <t-button 
          variant="outline" 
          class="form-button cancel-button" 
          bindtap="onCloseOrderForm"
        >取消</t-button>
        <t-button 
          theme="primary" 
          class="form-button submit-button" 
          bindtap="onSubmitOrderForm"
          loading="{{isSubmitting}}"
        >提交</t-button>
      </view>
    </view>
  </view>
</view> 