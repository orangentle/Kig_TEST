/* order-review.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.order-list {
  height: calc(100vh - 100rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-row .value.highlight {
  color: #ff8800;
  font-weight: 500;
}

.order-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 详情弹窗 */
.detail-popup {
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  height: 90vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
}

.detail-content {
  flex: 1;
  padding: 0 32rpx 32rpx;
  overflow-y: auto;
}

.detail-section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #ff8800;
}

.detail-row {
  display: flex;
  padding: 12rpx 0;
}

.detail-row .label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-row .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 身材数据网格 */
.body-data-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.body-item {
  width: calc(50% - 8rpx);
  background-color: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
}

.body-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.body-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 定制选项网格 */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.option-item.active {
  background-color: #fff0e0;
  color: #ff8800;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.remark-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 淘宝订单号输入 */
.taobao-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.taobao-input t-input {
  flex: 1;
}

/* 底部操作栏 */
.detail-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.detail-footer t-button {
  flex: 1;
}
