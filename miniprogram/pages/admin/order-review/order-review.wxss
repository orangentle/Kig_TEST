/* order-review.wxss - 订单审核优化版 */
.review-page {
  min-height: 100vh;
  background: #f5f6f8;
  display: flex;
  flex-direction: column;
}

/* 顶部标题 */
.top-bar {
  background: linear-gradient(135deg, #ff8800 0%, #ff6a00 100%);
  padding: 32rpx 32rpx 36rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  color: #fff;
}
.top-title { display: flex; flex-direction: column; gap: 6rpx; }
.brand { font-size: 38rpx; font-weight: 600; letter-spacing: 1rpx; }
.sub { font-size: 24rpx; opacity: 0.88; }

/* Tab Chips */
.tabs-scroll {
  background: #fff;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}
.tabs-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.tab-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f3f4f6;
  color: #555;
  border-radius: 999rpx;
  font-size: 26rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}
.tab-chip-active {
  background: #ff8800;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 136, 0, 0.28);
}
.tab-chip-warn:not(.tab-chip-active) {
  background: #fff4e0;
  color: #d4720d;
}
.tab-count {
  font-size: 22rpx;
  background: rgba(0,0,0,0.08);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  min-width: 32rpx;
  text-align: center;
}
.tab-chip-active .tab-count { background: rgba(255,255,255,0.28); }

/* 搜索 */
.search-wrap {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

/* 列表 */
.order-list {
  flex: 1;
  padding: 16rpx 24rpx 32rpx;
  box-sizing: border-box;
}

/* 卡片 */
.order-card {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.order-card.card-urgent { box-shadow: 0 2rpx 14rpx rgba(255, 77, 79, 0.18); }

.card-stripe {
  width: 6rpx;
  background: #d1d5db;
}
.stripe-pending  { background: #faad14; }
.stripe-urgent   { background: #ff4d4f; }
.stripe-rejected { background: #cf1322; }
.stripe-normal   { background: #52c41a; }

.card-body {
  flex: 1;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.card-row-1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tb-id-wrap {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.tb-id-label {
  font-size: 22rpx;
  color: #999;
  line-height: 1;
}
.tb-id {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-top: 6rpx;
  word-break: break-all;
}

.status-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.pill-pending  { background: #fff4e0; color: #d4720d; }
.pill-urgent   { background: #fff1f0; color: #cf1322; }
.pill-rejected { background: #f5f5f5; color: #888;  }
.pill-normal   { background: #f0faf2; color: #389e0d; }

.card-row-2 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #374151;
}
.role-name { font-weight: 500; color: #1f2937; }
.dot-sep { color: #d1d5db; }
.ip-name { color: #6b7280; }

.card-row-3 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.meta-text { font-size: 24rpx; color: #6b7280; }
.meta-text-light { color: #9ca3af; }

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.mini-tag {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: #f3f4f6;
  color: #4b5563;
}
.mini-tag-danger { background: #fff1f0; color: #cf1322; }

.card-row-4 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
}
.card-actions {
  display: flex;
  gap: 14rpx;
}
.btn-line {
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: 1rpx solid #e5e7eb;
  color: #555;
  line-height: 1.4;
}
.btn-reject {
  border-color: #ffd1d1;
  color: #cf1322;
  background: #fff;
}
.btn-approve {
  border-color: #ff8800;
  color: #fff;
  background: #ff8800;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}
.empty-block {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

/* ===== 详情弹窗 ===== */
.detail-popup {
  background: #f5f6f8;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  height: 90vh;
  display: flex;
  flex-direction: column;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.detail-title { font-size: 32rpx; font-weight: 600; color: #1f2937; }
.detail-status-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.detail-content {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.review-banner {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border-left: 6rpx solid #faad14;
  border-radius: 12rpx;
}
.review-banner-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 8rpx;
}
.review-banner-text {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.detail-section {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #ff8800;
  line-height: 1;
}
.detail-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}
.detail-row:last-child { border-bottom: none; }
.detail-row .label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 180rpx;
  flex-shrink: 0;
}
.detail-row .value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
  word-break: break-all;
}
.detail-row .value-strong { color: #ff8800; font-weight: 600; }

/* 身材数据 */
.body-data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.body-item {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.body-label {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 8rpx;
}
.body-value {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}
.body-unit {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 4rpx;
  font-weight: normal;
}

/* 选项 */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.option-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
.option-item.active {
  background: #fff4e0;
  color: #ff8800;
}

/* 图片 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.grid-img {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #f3f4f6;
}

/* 备注 */
.remark-box {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}
.remark-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.footer-spacer { height: 32rpx; }

/* 底部操作 */
.detail-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.footer-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.footer-btn-reject {
  background: #fff;
  color: #cf1322;
  border: 1rpx solid #ffd1d1;
}
.footer-btn-approve {
  background: linear-gradient(135deg, #ff8800, #ff6a00);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(255, 136, 0, 0.3);
}
