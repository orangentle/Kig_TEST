.container {
  background: #f5f7fa;
  min-height: 100vh;
  padding: 24rpx;
}

.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 8rpx;
}

.input, .picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #fafafa;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #fafafa;
}

.uploader {
  width: 100%;
  height: 220rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fafafa;
}

.preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  color: #999;
  font-size: 28rpx;
}

.empty {
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.work-item {
  display: flex;
  margin-bottom: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.work-cover {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
}

.work-meta {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
}

.status.on {
  background: rgba(82, 196, 26, 0.15);
  color: #52c41a;
}

.status.off {
  background: rgba(255, 77, 79, 0.15);
  color: #ff4d4f;
}


.desc {
  color: #666;
  font-size: 26rpx;
}

.meta {
  color: #999;
  font-size: 24rpx;
}

.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.switch-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #555;
}
