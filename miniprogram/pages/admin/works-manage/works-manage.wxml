<view class="container">
  <view class="page-head">
    <view class="head-left">
      <text class="page-head-title">作品管理</text>
      <text class="page-head-sub">维护客户端"作品橱窗"展示</text>
    </view>
    <view class="head-add" bindtap="onShowFormPopup">
      <t-icon name="add" size="36rpx" color="#fff" />
      <text>新增</text>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stats-item">
      <text class="stats-num">{{stats.total}}</text>
      <text class="stats-label">总数</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-num stats-num-on">{{stats.published}}</text>
      <text class="stats-label">已上架</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-num stats-num-off">{{stats.unpublished}}</text>
      <text class="stats-label">未上架</text>
    </view>
  </view>

  <!-- 工具栏 -->
  <view class="toolbar">
    <view class="search-wrap">
      <t-icon name="search" size="32rpx" color="#a88971" />
      <input
        class="search-input"
        placeholder="搜角色名 / 来源"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">
        <t-icon name="close-circle-filled" size="32rpx" color="#a88971" />
      </view>
    </view>
    <view class="select-toggle {{selectionMode ? 'is-on' : ''}}" bindtap="onToggleSelectionMode">
      <t-icon name="{{selectionMode ? 'close' : 'check'}}" size="32rpx" />
      <text>{{selectionMode ? '取消' : '多选'}}</text>
    </view>
  </view>

  <!-- 状态 chip -->
  <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        wx:for="{{statusFilters}}"
        wx:key="value"
        class="chip {{statusFilter === item.value ? 'chip-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSetStatus"
      >{{item.label}}<text wx:if="{{item.count > 0}}" class="chip-count">{{item.count}}</text></view>
    </view>
  </scroll-view>

  <!-- 分类 chip -->
  <scroll-view scroll-x class="chip-scroll chip-scroll-cat" enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        wx:for="{{categoryFilters}}"
        wx:key="value"
        class="chip chip-soft {{categoryFilter === item.value ? 'chip-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSetCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="list-meta">
    <text class="list-total">共筛出 {{filteredWorks.length}} 件</text>
    <view wx:if="{{selectionMode}}" class="list-select-all" bindtap="onSelectAllToggle">
      {{selectedIds.length === filteredWorks.length && filteredWorks.length > 0 ? '取消全选' : '全选'}}
    </view>
  </view>

  <!-- 列表 -->
  <view class="works-list">
    <view wx:if="{{isLoading && works.length === 0}}" class="empty">加载中...</view>
    <view wx:elif="{{works.length === 0}}" class="empty">还没有作品 ✨ 点右上角"新增"加一只吧</view>
    <view wx:elif="{{filteredWorks.length === 0}}" class="empty">没有匹配的作品 (´·ω·`)</view>

    <block wx:for="{{filteredWorks}}" wx:key="_id">
      <view class="work-row {{selectionMode ? 'work-row-select' : ''}} {{isSelected[item._id] ? 'work-row-on' : ''}}" data-id="{{item._id}}" bindtap="onRowTap" bindlongpress="onRowLongPress">
        <view wx:if="{{selectionMode}}" class="row-check {{isSelected[item._id] ? 'row-check-on' : ''}}">
          <t-icon wx:if="{{isSelected[item._id]}}" name="check" size="28rpx" color="#fff" />
        </view>
        <view class="row-cover-wrap">
          <image wx:if="{{item.coverUrl}}" class="row-cover" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="row-cover row-cover-placeholder">
            <t-icon name="image" size="56rpx" color="#d8c8b0" />
          </view>
          <view class="row-cat cat-{{item.category}}">{{item.categoryLabel}}</view>
        </view>
        <view class="row-meta">
          <view class="row-line-1">
            <text class="row-title">{{item.roleName}}</text>
            <text class="row-status {{item.isPublished ? 'on' : 'off'}}">{{item.isPublished ? '上架' : '未上架'}}</text>
          </view>
          <text class="row-source">{{item.source || '未填写来源'}}</text>
          <view class="row-line-3">
            <text class="row-price">{{item.price !== undefined && item.price !== null ? '¥ ' + item.price : '价格未公开'}}</text>
            <text class="row-date">{{item.displayDate}}</text>
          </view>
        </view>
        <view wx:if="{{!selectionMode}}" class="row-action" catchtap="onRowAction" data-id="{{item._id}}">
          <t-icon name="more" size="36rpx" color="#a88971" />
        </view>
      </view>
    </block>
  </view>

  <!-- 批量操作栏 -->
  <view wx:if="{{selectionMode && selectedIds.length > 0}}" class="batch-bar">
    <view class="batch-info">已选 {{selectedIds.length}} 件</view>
    <view class="batch-actions">
      <view class="batch-btn batch-btn-on" bindtap="onBatchPublish" data-publish="{{true}}">
        <t-icon name="upload" size="32rpx" /><text>批量上架</text>
      </view>
      <view class="batch-btn batch-btn-off" bindtap="onBatchPublish" data-publish="{{false}}">
        <t-icon name="download" size="32rpx" /><text>批量下架</text>
      </view>
      <view class="batch-btn batch-btn-danger" bindtap="onBatchDelete">
        <t-icon name="delete" size="32rpx" /><text>批量删除</text>
      </view>
    </view>
  </view>

  <!-- 单条操作菜单 -->
  <t-popup visible="{{actionSheetVisible}}" placement="bottom" bind:visible-change="onActionSheetClose">
    <view class="action-sheet">
      <view class="action-row" bindtap="onActionTogglePublish">
        <t-icon name="{{actionItem.isPublished ? 'download' : 'upload'}}" size="40rpx" color="#FF8C3A" />
        <text>{{actionItem.isPublished ? '下架' : '上架'}}</text>
      </view>
      <view class="action-row action-row-danger" bindtap="onActionDelete">
        <t-icon name="delete" size="40rpx" color="#E07458" />
        <text>删除</text>
      </view>
      <view class="action-cancel" bindtap="onActionSheetClose">取消</view>
    </view>
  </t-popup>

  <!-- 新增作品弹窗 -->
  <t-popup visible="{{formPopupVisible}}" placement="bottom" bind:visible-change="onFormPopupClose">
    <view class="form-popup" catchtap="">
      <view class="form-header">
        <text class="form-title">新增作品</text>
        <view class="form-close" bindtap="onFormPopupClose">
          <t-icon name="close" size="36rpx" color="#6B4F38" />
        </view>
      </view>
      <scroll-view scroll-y class="form-body">
        <view class="form-item">
          <view class="label">角色名称 <text class="required">*</text></view>
          <input class="input" placeholder="请输入角色名称" value="{{form.roleName}}" bindinput="onInputChange" data-field="roleName" />
        </view>
        <view class="form-item">
          <view class="label">来源 <text class="required">*</text></view>
          <input class="input" placeholder="如：原神 / 崩坏3 / 自设..." value="{{form.source}}" bindinput="onInputChange" data-field="source" />
        </view>
        <view class="form-row-2">
          <view class="form-item form-col">
            <view class="label">参考价格</view>
            <input class="input" type="digit" placeholder="选填" value="{{form.price}}" bindinput="onInputChange" data-field="price" />
          </view>
          <view class="form-item form-col">
            <view class="label">分类</view>
            <picker mode="selector" range="{{categories}}" range-key="label" value="{{form.categoryIndex}}" bindchange="onCategoryChange">
              <view class="picker">{{categories[form.categoryIndex].label}}</view>
            </picker>
          </view>
        </view>
        <view class="form-item form-row-toggle">
          <text class="label-inline">立即上架</text>
          <switch checked="{{form.isPublished}}" bindchange="onPublishSwitch" color="#FF8C3A" />
        </view>
        <view class="form-item">
          <view class="label">封面图 <text class="required">*</text></view>
          <view class="uploader {{form.coverPreview || form.coverFileId ? 'uploader-has-img' : ''}}" bindtap="onChooseImage">
            <block wx:if="{{form.coverPreview || form.coverFileId}}">
              <image class="preview" src="{{form.coverPreview || form.coverFileId}}" mode="aspectFill" />
              <view class="upload-mask" wx:if="{{isUploading}}">上传中...</view>
              <view class="cover-remove" catchtap="onRemoveCover" wx:if="{{!isUploading}}">×</view>
            </block>
            <view class="upload-placeholder" wx:else>
              <view class="upload-plus">+</view>
              <text class="upload-hint">点击上传封面图</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="form-footer">
        <t-button theme="default" bindtap="onFormPopupClose">取消</t-button>
        <t-button theme="primary" loading="{{isSubmitting}}" bindtap="onSubmit">保存作品</t-button>
      </view>
    </view>
  </t-popup>
</view>
