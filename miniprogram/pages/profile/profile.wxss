/* profile.wxss — 北欧极简 · 暖色克制 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fdf8f0;
}

/* 顶部 — 不再使用大块橙色渐变，回到米底 */
.header-gradient {
  padding: 24rpx 32rpx 60rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  background: #fdf8f0;
  position: relative;
  overflow: hidden;
}

.header-gradient::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #ffe9c2, transparent 70%);
  pointer-events: none;
}

.header-title {
  font-size: 42rpx;
  font-weight: 700;
  text-align: center;
  color: #3a2410;
  letter-spacing: 6rpx;
  position: relative;
  z-index: 2;
  font-family: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

/* 未登录态 */
.login-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.avatar-placeholder {
  margin-bottom: 36rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(168, 90, 21, 0.12);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-tip {
  font-size: 26rpx;
  color: #a08060;
  margin-bottom: 56rpx;
  letter-spacing: 2rpx;
}

.login-button {
  width: 80%;
}

/* 新登录流程：头像按钮 + 昵称输入 */
.login-avatar-btn {
  padding: 0;
  margin: 0 0 24rpx;
  background: transparent;
  line-height: normal;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-avatar-btn::after { border: none; }

.login-avatar-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(168, 90, 21, 0.12);
}

.login-avatar-hint {
  font-size: 24rpx;
  color: #a08060;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.login-nick-wrap {
  width: 80%;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

.login-nick-input {
  font-size: 30rpx;
  color: #3a2410;
  width: 100%;
}

/* 已登录头部 */
.user-info-container {
  padding: 8rpx 4rpx 0;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.avatar-container {
  position: relative;
  margin-right: 24rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 16rpx rgba(168, 90, 21, 0.12);
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #ff9020;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3a2410;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.user-id {
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

.edit-profile-btn {
  margin-left: auto;
  z-index: 10;
  position: relative;
}

/* 内容区 */
.page-container {
  flex: 1;
  padding: 0 24rpx 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 3;
}

/* 订单统计 */
.stats-container {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: #f0e6d6;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff9020;
  margin-bottom: 8rpx;
  line-height: 1;
  font-family: "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
}

.stat-label {
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

/* 订单段 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a2410;
  position: relative;
  padding-left: 16rpx;
  letter-spacing: 2rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #ff9020;
}

.section-more {
  font-size: 24rpx;
  color: #c25a1a;
  letter-spacing: 1rpx;
}

/* 订单列表 */
.order-list {
  margin-bottom: 32rpx;
}

.order-item {
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
  transition: all 0.2s ease;
}

.order-item:active {
  transform: scale(0.99);
  background: #fdf8f0;
}

.order-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx dashed #f0e6d6;
}

.order-id {
  font-size: 22rpx;
  color: #a08060;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.order-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.status-pending { background: #fff4e6; color: #c25a1a; border: 1rpx solid #ffd8a8; }
.status-approved { background: #eaf3ff; color: #2070d8; border: 1rpx solid #cce0f5; }
.status-normal { background: #fff4e6; color: #ff9020; border: 1rpx solid #ffd8a8; }
.status-completed { background: #eef7ee; color: #4a8a4a; border: 1rpx solid #c8e6c8; }
.status-rejected { background: #fdecec; color: #d04848; border: 1rpx solid #f5cccc; }

.order-item-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info {
  flex: 1;
}

.order-role {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a2410;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.order-time {
  font-size: 22rpx;
  color: #a08060;
}

.order-action {
  color: #c25a1a;
  font-size: 24rpx;
  font-weight: 500;
  padding-left: 16rpx;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

.empty-image {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
  border-radius: 50%;
}

.empty-text {
  font-size: 24rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

/* 服务按钮 */
.service-container {
  margin-top: 24rpx;
}

.service-button,
.admin-button {
  width: 100%;
}

.admin-button {
  margin-bottom: 24rpx;
}

.admin-login-trigger {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.admin-click-hint {
  font-size: 22rpx;
  color: #c25a1a;
  letter-spacing: 1rpx;
}

/* 把 t-button primary 在该页强制为单色暖橙 */
.primary-button {
  background: #ff9020 !important;
  border-radius: 999rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 144, 32, 0.25) !important;
  letter-spacing: 4rpx !important;
  font-weight: 500 !important;
}

/* 编辑弹窗 */
.edit-profile-popup {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.edit-profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f5efe4;
}

.edit-profile-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3a2410;
  letter-spacing: 2rpx;
}

.edit-profile-content {
  height: 1000rpx;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.edit-profile-scroll-inner {
  padding-bottom: 40rpx;
}

.info-section {
  margin-bottom: 36rpx;
}

.section-title-small {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a2410;
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #ff9020;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.edit-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.edit-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 16rpx rgba(168, 90, 21, 0.12);
}

.edit-avatar-hint {
  font-size: 22rpx;
  color: #c25a1a;
  letter-spacing: 1rpx;
}

.edit-input-section {
  margin-bottom: 16rpx;
}

.edit-profile-footer {
  padding: 24rpx 32rpx 36rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f5efe4;
}
