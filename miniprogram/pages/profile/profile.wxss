/* profile.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f7fa;
}

.header-gradient {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  color: white;
  border-radius: 0 0 30rpx 30rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
}

.login-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.avatar-placeholder {
  margin-bottom: 32rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-button {
  width: 80%;
}

.user-info-container {
  padding: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
}

/* 头像容器和编辑图标 */
.avatar-container {
  position: relative;
  margin-right: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background-color: #ff8800;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 编辑资料按钮 */
.edit-profile-btn {
  margin-left: auto;
  z-index: 10;
  position: relative;
}

.page-container {
  flex: 1;
  padding: 24rpx;
}

/* 订单统计 */
.stats-container {
  display: flex;
  justify-content: space-around;
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff8800;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 订单列表 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.section-more {
  font-size: 24rpx;
  color: #ff8800;
}

.order-list {
  margin-bottom: 24rpx;
}

.order-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: 500;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-pending {
  background-color: #fffbe6;
  color: #faad14;
}

.status-approved {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-normal {
  background-color: #fff0e0;
  color: #ff8800;
}

.status-completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.order-item-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info {
  flex: 1;
}

.order-role {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-action {
  color: #ff8800;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 联系客服按钮样式 */
.service-container {
  margin-top: 48rpx;
}

.service-button {
  width: 100%;
}

/* 管理员入口样式 */
.admin-button {
  width: 100%;
  margin-bottom: 24rpx;
}

.admin-login-trigger {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.admin-click-hint {
  font-size: 24rpx;
  color: #ff8800;
}

/* 编辑个人资料弹窗 */
.edit-profile-popup {
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.edit-profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
}

.edit-profile-title {
  font-size: 36rpx;
  font-weight: bold;
}

.edit-profile-content {
  height: 1000rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.edit-profile-scroll-inner {
  padding-bottom: 40rpx;
}

/* 信息分组 */
.info-section {
  margin-bottom: 32rpx;
}

.section-title-small {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #ff8800;
}

.edit-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.edit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  border: 2rpx solid #f0f0f0;
}

.edit-avatar-hint {
  font-size: 26rpx;
  color: #ff8800;
}

.edit-input-section {
  margin-bottom: 20rpx;
}

.edit-profile-footer {
  padding: 20rpx 32rpx 32rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
} 