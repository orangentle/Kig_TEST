<!--profile.wxml-->
<view class="container">
  <!-- 未登录状态 -->
  <block wx:if="{{!hasLogin}}">
    <view class="header-gradient">
      <text class="header-title">个人中心</text>
    </view>
    
    <view class="login-container">
      <view class="avatar-placeholder">
        <image class="avatar-image" src="/assets/images/icon.jpg" mode="aspectFill"></image>
      </view>
      <text class="login-tip">登录后查看您的订单信息</text>
      <t-button 
        theme="primary" 
        size="large" 
        shape="round" 
        open-type="getUserInfo" 
        bindgetuserinfo="onGetUserInfo"
        class="login-button primary-button"
      >
        微信一键登录
      </t-button>
    </view>
  </block>
  
  <!-- 已登录状态 -->
  <block wx:else>
    <view class="header-gradient">
      <view class="user-info-container">
        <view class="avatar-container" bindtap="chooseAvatar">
          <image 
            class="user-avatar" 
            src="{{userInfo.avatarUrl || '/assets/images/icon.jpg'}}" 
            mode="aspectFill"
          ></image>
          <view class="avatar-edit-icon">
            <t-icon name="edit" size="24rpx" color="#fff"></t-icon>
          </view>
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.nickName || '鼠鼠用户'}}</text>
          <text class="user-id" bindtap="onAdminLoginTrigger">ID: {{userId || '12345678'}}</text>
        </view>
        <view class="edit-profile-btn">
          <t-button icon="edit" size="small" shape="round" variant="outline" theme="primary" bind:tap="showEditProfileModal">编辑资料</t-button>
        </view>
      </view>
    </view>
    
    <view class="page-container">
      <!-- 订单统计 -->
      <view class="stats-container">
        <view class="stat-item">
          <text class="stat-number">{{orderStats.processing || 0}}</text>
          <text class="stat-label">制作中</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{orderStats.completed || 0}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{orderStats.total || 0}}</text>
          <text class="stat-label">全部订单</text>
        </view>
      </view>
      
      <!-- 我的订单 -->
      <view class="section-header">
        <text class="section-title">我的订单</text>
        <text class="section-more" bindtap="viewAllOrders">查看全部</text>
      </view>
      
      <view class="order-list">
        <block wx:if="{{orders.length > 0}}">
          <view 
            class="order-item" 
            wx:for="{{orders}}" 
            wx:key="orderId"
            bindtap="onOrderClick"
            data-order-id="{{item.orderId}}"
          >
            <view class="order-item-header">
              <text class="order-id">订单号: {{item.orderId}}</text>
              <view class="order-status {{item.status === 'processing' ? 'status-normal' : 'status-completed'}}">
                {{item.status === 'processing' ? '制作中' : '已完成'}}
              </view>
            </view>
            
            <view class="order-item-content">
              <view class="order-info">
                <view class="order-role">{{item.roleName}}</view>
                <view class="order-time">下单时间: {{item.orderTime}}</view>
              </view>
              <view class="order-action">查看详情</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="empty-state">
            <image class="empty-image" src="/assets/images/icon.jpg" mode="aspectFit"></image>
            <text class="empty-text">暂无订单信息</text>
          </view>
        </block>
      </view>
      
      <!-- 功能按钮区域 -->
      <view class="service-container">
        <!-- 管理员入口 - 只对管理员显示 -->
        <block wx:if="{{isAdmin}}">
          <t-button 
            theme="primary" 
            size="large" 
            shape="round" 
            bind:tap="enterAdminPanel"
            class="admin-button mb-medium primary-button"
          >
            进入管理后台
          </t-button>
        </block>
        
        <!-- 管理员登录入口 - 连续点击用户ID 5 次触发 -->
        <view class="admin-login-trigger" bindtap="onAdminLoginTrigger" wx:if="{{adminClickCount > 0}}">
          <text class="admin-click-hint">再点击 {{5 - adminClickCount}} 次进入管理员模式</text>
        </view>
        
        <!-- 联系客服按钮 -->
        <t-button 
          theme="primary" 
          size="large" 
          shape="round" 
          bind:tap="contactService"
          class="service-button primary-button"
        >
          联系客服
        </t-button>
      </view>
    </view>
  </block>

  <!-- 编辑个人资料弹窗 -->
  <t-popup visible="{{showEditPopup}}" bind:visible-change="onCloseEditPopup" placement="bottom">
    <view class="edit-profile-popup">
      <view class="edit-profile-header">
        <text class="edit-profile-title">编辑个人资料</text>
        <t-icon name="close" size="48rpx" color="#999" bind:tap="onCloseEditPopup" />
      </view>
      
      <view class="edit-profile-content">
        <view class="edit-avatar-section" bindtap="chooseAvatar">
          <image class="edit-avatar" src="{{tempUserInfo.avatarUrl || '/assets/images/icon.jpg'}}" mode="aspectFill"></image>
          <text class="edit-avatar-hint">点击修改头像</text>
        </view>
        
        <view class="edit-input-section">
          <t-input label="昵称" value="{{tempUserInfo.nickName}}" placeholder="请输入昵称" bind:change="onNicknameChange" />
        </view>
      </view>
      
      <view class="edit-profile-footer">
        <t-button theme="primary" size="large" block bind:tap="saveUserProfile">保存</t-button>
      </view>
    </view>
  </t-popup>
</view> 