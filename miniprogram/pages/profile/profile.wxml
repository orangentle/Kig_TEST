<!--profile.wxml-->
<view class="container">
  <!-- 未登录状态 -->
  <block wx:if="{{!hasLogin}}">
    <view class="header-gradient">
      <text class="header-title">个人中心</text>
    </view>

    <view class="login-container">
      <text class="login-tip">完善头像和昵称即可登录</text>

      <!-- 头像：微信原生 chooseAvatar 能力 -->
      <button
        class="login-avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onLoginChooseAvatar"
      >
        <image
          wx:if="{{loginForm.avatarUrl}}"
          class="login-avatar-image"
          src="{{loginForm.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="login-avatar-image avatar-placeholder">
          <t-icon name="user-1" size="96rpx" color="#d8c8b0" />
        </view>
        <text class="login-avatar-hint">{{loginForm.avatarUrl ? '点击更换头像' : '点击选择头像'}}</text>
      </button>

      <!-- 昵称：使用 type="nickname"，获焦时微信会展示昵称建议 -->
      <view class="login-nick-wrap">
        <input
          class="login-nick-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{loginForm.nickName}}"
          bindinput="onLoginNicknameInput"
          bindblur="onLoginNicknameInput"
        />
      </view>

      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{isLoading}}"
        bind:tap="onLoginSubmit"
        class="login-button primary-button"
        hover-class="primary-button-hover"
        hover-stay-time="80"
      >
        登录
      </t-button>
    </view>
  </block>
  
  <!-- 已登录状态 -->
  <block wx:else>
    <view class="header-gradient">
      <view class="user-info-container">
        <view class="avatar-container" bindtap="chooseAvatar" bindlongpress="onAdminLongPress">
          <image
            wx:if="{{userInfo.avatarUrl}}"
            class="user-avatar"
            src="{{userInfo.avatarUrl}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="user-avatar avatar-placeholder">
            <t-icon name="user-1" size="72rpx" color="#d8c8b0" />
          </view>
          <view class="avatar-edit-icon">
            <t-icon name="edit" size="24rpx" color="#fff"></t-icon>
          </view>
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.nickName || '鼠鼠用户'}}</text>
          <text class="user-id" wx:if="{{taobaoName}}">淘宝: {{taobaoName}}</text>
          <text class="user-id user-id-empty" wx:else bind:tap="showEditProfileModal">点这里绑定淘宝旺旺 →</text>
        </view>
        <view class="edit-profile-btn">
          <t-button icon="edit" size="small" shape="round" variant="outline" theme="primary" bind:tap="showEditProfileModal">编辑资料</t-button>
        </view>
      </view>
    </view>
    
    <view class="page-container">
      <!-- 订单统计 -->
      <view class="stats-container">
        <view class="stat-item">
          <text class="stat-number">{{orderStats.pending || 0}}</text>
          <text class="stat-label">待审核</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{orderStats.processing || 0}}</text>
          <text class="stat-label">制作中</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{orderStats.completed || 0}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{orderStats.total || 0}}</text>
          <text class="stat-label">全部</text>
        </view>
      </view>
      
      <!-- 我的订单 -->
      <view class="section-header">
        <text class="section-title">我的订单</text>
      </view>
      
      <view class="order-list">
        <block wx:if="{{orders.length > 0}}">
          <view
            class="order-item"
            wx:for="{{orders}}"
            wx:key="orderId"
            bindtap="onOrderClick"
            data-tb-order-id="{{item.tbOrderId}}"
          >
            <view class="order-item-header">
              <text class="order-id">订单号: {{item.orderId}}</text>
              <view class="order-status {{item.status === 'pending' ? 'status-pending' : item.status === 'completed' ? 'status-completed' : item.status === 'canceled' ? 'status-canceled' : 'status-normal'}}">
                {{item.status === 'pending' ? '待审核' : item.status === 'canceled' ? '已取消' : item.status === 'completed' ? '已完成' : '制作中'}}
              </view>
            </view>
            
            <view class="order-item-content">
              <view class="order-info">
                <view class="order-role">{{item.roleName}}</view>
                <view class="order-time">下单时间: {{item.orderTime}}</view>
              </view>
              <view class="order-action">查看详情</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="empty-state">
            <view class="empty-image empty-image-placeholder">
              <t-icon name="file-copy" size="80rpx" color="#d8c8b0" />
            </view>
            <text class="empty-text">还没有订单呢~ 快去定制一只吧 ✨</text>
          </view>
        </block>
      </view>
      
      <!-- 工具卡 -->
      <view class="tool-card" bindtap="onOpenWorkDayCalc">
        <view class="tool-icon">
          <t-icon name="calendar" size="44rpx" color="#ff9020" />
        </view>
        <view class="tool-body">
          <text class="tool-title">工期计算器</text>
          <text class="tool-desc">按工作日估算预计完成日(自动跳过周末+法定节假日)</text>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="#c8b89a" />
      </view>

      <!-- 功能按钮区域 -->
      <view class="service-container">
        <!-- 管理员入口 - 只对管理员显示 -->
        <block wx:if="{{isAdmin}}">
          <t-button
            theme="primary"
            size="large"
            shape="round"
            bind:tap="enterAdminPanel"
            class="admin-button mb-medium primary-button"
            hover-class="primary-button-hover"
            hover-stay-time="80"
          >
            进入管理后台
          </t-button>
        </block>
      </view>
    </view>
  </block>

  <!-- 编辑个人资料弹窗 -->
  <t-popup visible="{{showEditPopup}}" bind:visible-change="onCloseEditPopup" placement="bottom">
    <view class="edit-profile-popup">
      <view class="edit-profile-header">
        <text class="edit-profile-title">编辑个人资料</text>
        <t-icon name="close" size="48rpx" color="#999" bind:tap="onCloseEditPopup" />
      </view>
      
      <scroll-view scroll-y class="edit-profile-content" enhanced show-scrollbar="{{false}}">
        <view class="edit-profile-scroll-inner">
          <view class="edit-avatar-section" bindtap="chooseAvatar">
            <image wx:if="{{tempUserInfo.avatarUrl}}" class="edit-avatar" src="{{tempUserInfo.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="edit-avatar avatar-placeholder">
              <t-icon name="user-1" size="80rpx" color="#d8c8b0" />
            </view>
            <text class="edit-avatar-hint">点击修改头像</text>
          </view>
        
        <!-- 用户信息 -->
        <view class="info-section">
          <view class="section-title-small">用户信息</view>
          <view class="edit-input-section">
            <t-input label="昵称" value="{{tempUserInfo.nickName}}" placeholder="请输入昵称" bind:change="onNicknameChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="淘宝名称" value="{{tempUserInfo.taobaoName}}" placeholder="请输入淘宝名称" bind:change="onTaobaoNameChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="QQ账号" value="{{tempUserInfo.qq}}" placeholder="请输入QQ账号" bind:change="onQQChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="手机号" value="{{tempUserInfo.phone}}" placeholder="请输入手机号" type="number" bind:change="onPhoneChange" />
          </view>
        </view>
        
        <!-- 身材数据 -->
        <view class="info-section">
          <view class="section-title-small">身材数据</view>
          <view class="edit-input-section">
            <t-input label="身高(cm)" value="{{tempBodyMeasurements.height || ''}}" placeholder="请输入身高" type="digit" bind:change="onHeightChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="体重(kg)" value="{{tempBodyMeasurements.weight || ''}}" placeholder="请输入体重" type="digit" bind:change="onWeightChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="头围(cm)" value="{{tempBodyMeasurements.headCircumference || ''}}" placeholder="请输入头围" type="digit" bind:change="onHeadCircumferenceChange" />
          </view>
          <view class="edit-input-section">
            <t-input label="肩宽(cm)" value="{{tempBodyMeasurements.shoulderWidth || ''}}" placeholder="请输入肩宽" type="digit" bind:change="onShoulderWidthChange" />
          </view>
        </view>

        <view class="edit-profile-save">
          <t-button theme="primary" size="large" block bind:tap="saveUserProfile">保存</t-button>
        </view>
        </view>
      </scroll-view>
    </view>
  </t-popup>
</view> 