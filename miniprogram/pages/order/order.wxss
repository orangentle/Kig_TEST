/* order.wxss — 北欧极简 · 暖色克制 */
.container {
  min-height: 100vh;
  background: #fdf8f0;
  display: flex;
  flex-direction: column;
}

/* 页面头部 — 不再使用大块橙色渐变，回到米底+点缀 */
.page-header {
  padding: 64rpx 40rpx 24rpx;
  padding-top: calc(72rpx + env(safe-area-inset-top));
  background: #fdf8f0;
  text-align: center;
  position: relative;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
  color: #3a2410;
  font-family: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

.page-subtitle {
  font-size: 24rpx;
  color: #a08060;
  letter-spacing: 3rpx;
}

/* 标题下方装饰：橙线 + 中心爪印 */
.page-header::after {
  content: "✦";
  display: block;
  margin: 20rpx auto 0;
  font-size: 24rpx;
  color: #ff9020;
  width: 96rpx;
  border-top: 2rpx solid transparent;
  background: linear-gradient(90deg, transparent, #ffd8a8 30%, #ffd8a8 70%, transparent);
  background-size: 100% 2rpx;
  background-position: 0 50%;
  background-repeat: no-repeat;
  line-height: 1;
}

/* 滚动表单 */
.form-scroll {
  flex: 1;
  position: relative;
}

.form-content {
  padding: 16rpx 24rpx 0;
}

/* 区段卡片：白底 / 细描边 / 极淡阴影 */
.section {
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid #f5efe4;
  font-size: 28rpx;
  font-weight: 600;
  color: #3a2410;
  letter-spacing: 2rpx;
}

.section-title t-icon {
  margin-right: 14rpx;
}

.form-item {
  padding: 4rpx 12rpx;
}

/* 身材数据预览 */
.body-data-preview {
  padding: 20rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
}

.body-data-item {
  width: 50%;
  display: flex;
  align-items: baseline;
  padding: 10rpx 0;
}

.body-data-item .label {
  font-size: 24rpx;
  color: #a08060;
  margin-right: 10rpx;
  letter-spacing: 1rpx;
}

.body-data-item .value {
  font-size: 28rpx;
  color: #3a2410;
  font-weight: 600;
}

.body-data-tip {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #a08060;
  font-size: 24rpx;
}

.body-data-tip text {
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

/* 上传区 */
.upload-area {
  padding: 24rpx 32rpx;
}

.upload-tip {
  display: block;
  font-size: 22rpx;
  color: #a08060;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}

/* 加急提示 */
.urgent-notice {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  background: #fff4e6;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ffd8a8;
}

.urgent-text {
  font-size: 24rpx;
  color: #c25a1a;
  margin-left: 12rpx;
  flex: 1;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* 底部占位 + 提交栏 */
.bottom-placeholder {
  height: 220rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #f0e6d6;
  padding: 14rpx 32rpx 18rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 99;
}

.submit-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

.submit-tip t-icon {
  margin-right: 8rpx;
}

/* 主按钮：单色暖橙，符合北欧风 */
.t-button--primary {
  background: #ff9020 !important;
  border-color: transparent !important;
  border-radius: 999rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 144, 32, 0.25) !important;
  letter-spacing: 6rpx !important;
  font-weight: 500 !important;
}
