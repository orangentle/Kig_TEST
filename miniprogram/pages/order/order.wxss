/* order.wxss — 北欧极简 · 暖奶咖 · 鼠鼠手作 */
page {
  /* 统一手写字体族（决定本页所有装饰文字的字形） */
  --font-deco: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  display: flex;
  flex-direction: column;
  position: relative;
  background-image:
    url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='240' height='240' viewBox='0 0 240 240'%3E%3Cg fill='%23c89968' fill-opacity='0.07'%3E%3Cg transform='translate(30 40) rotate(-20)'%3E%3Cellipse cx='30' cy='40' rx='14' ry='12'/%3E%3Cellipse cx='14' cy='22' rx='5' ry='7'/%3E%3Cellipse cx='25' cy='13' rx='5' ry='7'/%3E%3Cellipse cx='38' cy='13' rx='5' ry='7'/%3E%3Cellipse cx='49' cy='22' rx='5' ry='7'/%3E%3C/g%3E%3Cg transform='translate(160 140) rotate(18)'%3E%3Cellipse cx='30' cy='40' rx='14' ry='12'/%3E%3Cellipse cx='14' cy='22' rx='5' ry='7'/%3E%3Cellipse cx='25' cy='13' rx='5' ry='7'/%3E%3Cellipse cx='38' cy='13' rx='5' ry='7'/%3E%3Cellipse cx='49' cy='22' rx='5' ry='7'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  background-size: 480rpx 480rpx;
  background-repeat: repeat;
}

/* 页面头部 — 品牌字标 */
.page-header {
  padding: 70rpx 40rpx 36rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg) 70%, rgba(255, 249, 238, 0) 100%);
  text-align: center;
  position: relative;
  z-index: 1;
}

/* 分隔：小星星 + 爪印 + 小星星 */
.brand-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.divider-star {
  font-size: 22rpx;
  color: var(--color-primary-light);
  margin: 0 14rpx;
  line-height: 1;
}

.divider-paw {
  width: 36rpx;
  height: 36rpx;
  background-image:
    url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 60' fill='%23c25a1a'%3E%3Cellipse cx='30' cy='42' rx='15' ry='13'/%3E%3Cellipse cx='13' cy='23' rx='5' ry='7'/%3E%3Cellipse cx='25' cy='13' rx='5' ry='8'/%3E%3Cellipse cx='38' cy='13' rx='5' ry='8'/%3E%3Cellipse cx='50' cy='23' rx='5' ry='7'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 主标题 — 大号手写 */
.page-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 8rpx;
  line-height: 1.15;
  margin-bottom: 16rpx;
  text-indent: 8rpx;
  font-family: var(--font-deco);
  text-shadow: 0 2rpx 0 rgba(200, 153, 104, 0.15);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-deco-warm);
  letter-spacing: 2rpx;
  font-weight: 500;
  line-height: 1.4;
  font-family: var(--font-deco);
}

/* 滚动表单 */
.form-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
}

.form-content {
  padding: 8rpx 24rpx 0;
}

/* 区段卡片：白底 / 暖描边 / 金色顶线 */
.section {
  background: var(--color-card);
  border: 1rpx solid var(--color-divider);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  position: relative;
}

/* 卡片顶部金线点缀 */
.section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 153, 104, 0.5), transparent);
}

/* 区段标题 — icon 圆容器 + 文字 + 延伸线 */
.section-title {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx 20rpx;
  gap: 16rpx;
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  border: 1rpx solid var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 3rpx;
  font-family: var(--font-deco);
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, var(--color-divider), transparent);
  margin-left: 8rpx;
}

.form-item {
  padding: 4rpx 16rpx;
}

.form-hint {
  font-size: 22rpx;
  padding: 6rpx 24rpx 0;
  line-height: 1.4;
}
.form-hint-error {
  color: var(--color-danger, #cf1322);
}

/* 身材数据预览 */
.body-data-preview {
  padding: 12rpx 32rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.body-data-item {
  width: 50%;
  display: flex;
  align-items: baseline;
  padding: 10rpx 0;
}

.body-data-item .label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-right: 10rpx;
  letter-spacing: 0;
}

.body-data-item .value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
  letter-spacing: 0;
}

.body-data-tip {
  padding: 12rpx 32rpx 32rpx;
}

/* 空状态卡：温和提示 + 醒目 CTA */
.empty-body-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 24rpx;
  background: linear-gradient(180deg, #fffaf2 0%, #fff4e5 100%);
  border: 1rpx dashed #f3d9b3;
  border-radius: 20rpx;
}

.empty-body-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 14rpx;
  filter: saturate(0.9);
}

.empty-body-title {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.empty-body-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 0;
  line-height: 1.5;
  text-align: center;
  margin-bottom: 20rpx;
}

.empty-body-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 56rpx;
  padding: 0 22rpx 0 26rpx;
  font-size: 24rpx;
  color: #fff;
  letter-spacing: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffc592 0%, #ff9a52 45%, #ee7a2a 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.45),
    0 4rpx 12rpx rgba(232, 114, 42, 0.28);
}
.empty-body-btn:active { opacity: 0.85; }

/* 上传区 */
.upload-area {
  padding: 12rpx 32rpx 28rpx;
}

.uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.uploader-tile,
.uploader-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.uploader-tile {
  background: #f5ede0;
  border: 1rpx solid var(--color-divider);
}

.uploader-img {
  width: 100%;
  height: 100%;
  display: block;
}

.uploader-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploader-add {
  background: #fffaf2;
  border: 2rpx dashed #f3d9b3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.uploader-add:active {
  background: #fff4e5;
}

.uploader-add-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

.upload-tip {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 14rpx;
  letter-spacing: 0;
  line-height: 1.6;
}

/* 加急提示 */
.urgent-notice {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, var(--color-primary-bg), var(--color-deco-soft));
  margin: 0 32rpx 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid #FFD8A8;
}

.urgent-text {
  font-size: 24rpx;
  color: var(--color-deco-warm);
  margin-left: 12rpx;
  flex: 1;
  line-height: 1.5;
  letter-spacing: 0;
}

/* 底部占位 + 提交栏 */
.bottom-placeholder {
  height: 240rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--color-divider);
  padding: 18rpx 32rpx 18rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 99;
  box-shadow: 0 -4rpx 24rpx rgba(168, 90, 21, 0.06);
}

.submit-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 0;
}

.submit-tip t-icon {
  margin-right: 8rpx;
}

/* 提交摘要 chips */
.submit-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
  justify-content: center;
}

.sum-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  border-radius: 999rpx;
  background: #f7f1e8;
  color: #a89070;
  border: 1rpx solid transparent;
  line-height: 1;
}

.sum-chip.chip-on {
  background: var(--color-primary-bg);
  color: var(--color-deco-warm);
  border-color: #f3d9b3;
}

.sum-chip.chip-urgent {
  background: linear-gradient(135deg, #ff9a4a, #e8722a);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 2rpx 6rpx rgba(232, 114, 42, 0.3);
}

/* 主按钮：使用全局 .primary-button 共享奶油糖果样式 */
