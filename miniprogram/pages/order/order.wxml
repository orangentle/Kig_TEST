<!--order.wxml-->
<view class="container">
  <view class="page-header">
    <view class="brand-divider">
      <text class="divider-star">✦</text>
      <view class="divider-paw"></view>
      <text class="divider-star">✦</text>
    </view>
    <text class="page-title">头壳定制</text>
    <text class="page-subtitle">捏一只独一无二的小可爱 ♡</text>
  </view>

  <scroll-view scroll-y class="form-scroll">
    <view class="form-content">
      <!-- 基本信息 -->
      <view class="section">
        <view class="section-title">
          <view class="section-icon"><t-icon name="user" size="32rpx" color="#c25a1a" /></view>
          <text class="section-text">基本信息</text>
          <view class="section-line"></view>
        </view>

        <view class="form-item">
          <t-input
            label="淘宝订单号"
            placeholder="请填写淘宝定金订单号"
            value="{{formData.tbOrderId}}"
            bind:change="onTbOrderIdChange"
            bind:blur="onTbOrderIdBlur"
            required
          />
          <view wx:if="{{tbOrderIdHint}}" class="form-hint form-hint-error">{{tbOrderIdHint}}</view>
        </view>

        <view class="form-item">
          <t-input
            label="角色名称"
            placeholder="请输入角色名称"
            value="{{formData.roleName}}"
            bind:change="onRoleNameChange"
            required
          />
        </view>

        <view class="form-item">
          <t-input
            label="角色所属IP"
            placeholder="如：原神、星铁、原创"
            value="{{formData.ip}}"
            bind:change="onIpChange"
            required
          />
        </view>
      </view>

      <!-- 身材数据 -->
      <view class="section">
        <view class="section-title">
          <view class="section-icon"><t-icon name="measurement" size="32rpx" color="#c25a1a" /></view>
          <text class="section-text">身材数据</text>
          <view class="section-line"></view>
        </view>

        <t-cell
          title="使用个人资料身材数据"
          description="{{useProfileBodyData ? '已开启：将使用您个人资料中的身材数据' : '已关闭：请在下方填写身材数据'}}"
          hover
        >
          <t-switch
            slot="note"
            value="{{useProfileBodyData}}"
            bind:change="onUseProfileBodyDataChange"
          />
        </t-cell>

        <block wx:if="{{!useProfileBodyData}}">
          <view class="form-item">
            <t-input label="身高(cm)" placeholder="请输入身高" type="digit" value="{{formData.height}}" bind:change="onHeightChange" />
          </view>
          <view class="form-item">
            <t-input label="体重(kg)" placeholder="请输入体重" type="digit" value="{{formData.weight}}" bind:change="onWeightChange" />
          </view>
          <view class="form-item">
            <t-input label="头围(cm)" placeholder="请输入头围" type="digit" value="{{formData.headCircumference}}" bind:change="onHeadCircumferenceChange" />
          </view>
          <view class="form-item">
            <t-input label="肩宽(cm)" placeholder="请输入肩宽" type="digit" value="{{formData.shoulderWidth}}" bind:change="onShoulderWidthChange" />
          </view>
        </block>

        <block wx:else>
          <view class="body-data-preview" wx:if="{{profileBodyData}}">
            <view class="body-data-item">
              <text class="label">身高:</text>
              <text class="value">{{profileBodyData.height || '未填写'}} cm</text>
            </view>
            <view class="body-data-item">
              <text class="label">体重:</text>
              <text class="value">{{profileBodyData.weight || '未填写'}} kg</text>
            </view>
            <view class="body-data-item">
              <text class="label">头围:</text>
              <text class="value">{{profileBodyData.headCircumference || '未填写'}} cm</text>
            </view>
            <view class="body-data-item">
              <text class="label">肩宽:</text>
              <text class="value">{{profileBodyData.shoulderWidth || '未填写'}} cm</text>
            </view>
          </view>
          <view class="body-data-tip" wx:else>
            <text>您尚未在个人资料中填写身材数据，请先去完善。</text>
            <t-button size="small" variant="text" theme="primary" bind:tap="goToProfile">去完善</t-button>
          </view>
        </block>
      </view>

      <!-- 角色参考图 -->
      <view class="section">
        <view class="section-title">
          <view class="section-icon"><t-icon name="image" size="32rpx" color="#c25a1a" /></view>
          <text class="section-text">角色参考图</text>
          <view class="section-line"></view>
        </view>

        <view class="upload-area">
          <t-upload
            media-type="{{['image']}}"
            max="3"
            files="{{referenceImages}}"
            bind:add="onUploadAdd"
            bind:remove="onUploadRemove"
          />
          <text class="upload-tip">最多 3 张 · 推荐正面 / 侧面 / 背面，若只有一张也可提交</text>
        </view>
      </view>

      <!-- 定制选项 -->
      <view class="section">
        <view class="section-title">
          <view class="section-icon"><t-icon name="setting" size="32rpx" color="#c25a1a" /></view>
          <text class="section-text">定制选项</text>
          <view class="section-line"></view>
        </view>

        <t-cell title="需要配饰" description="发饰 / 帽子 / 角 等角色专属道具" hover>
          <t-switch slot="note" value="{{formData.needAccessory}}" bind:change="onAccessoryChange" />
        </t-cell>

        <t-cell title="替换脸" description="可更换不同表情的面部" hover>
          <t-switch slot="note" value="{{formData.needReplaceFace}}" bind:change="onReplaceFaceChange" />
        </t-cell>

        <block wx:if="{{formData.needReplaceFace}}">
          <picker mode="selector" range="{{faceCountOptions}}" value="{{faceCountIndex}}" bindchange="onFaceCountChange">
            <t-cell title="替换脸数量" note="{{formData.replaceFaceCount}} 张" arrow hover />
          </picker>

          <view class="upload-area">
            <t-upload
              media-type="{{['image']}}"
              max="{{formData.replaceFaceCount}}"
              files="{{replaceFaceImages}}"
              bind:add="onFaceUploadAdd"
              bind:remove="onFaceUploadRemove"
            />
            <text class="upload-tip">请上传 {{formData.replaceFaceCount}} 张替换脸表情图（一脸一图）</text>
          </view>
        </block>

        <t-cell title="加急处理" description="鼠鼠们加班加点为你赶工，加急费 +1200 元" hover>
          <t-switch slot="note" value="{{formData.isUrgent}}" bind:change="onUrgentChange" />
        </t-cell>

        <view class="urgent-notice" wx:if="{{formData.isUrgent}}">
          <t-icon name="error-circle-filled" size="32rpx" color="#ff8800" />
          <text class="urgent-text">鼠鼠们会加班加点为你赶工，将额外收取 1200 元加急费</text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="section">
        <view class="section-title">
          <view class="section-icon"><t-icon name="edit" size="32rpx" color="#c25a1a" /></view>
          <text class="section-text">备注说明</text>
          <view class="section-line"></view>
        </view>

        <view class="form-item">
          <t-textarea
            placeholder="如有特殊要求请简要说明"
            value="{{formData.remark}}"
            bind:change="onRemarkChange"
            maxlength="150"
            indicator
          />
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <view class="submit-tip">
      <t-icon name="info-circle" size="32rpx" color="#ff8800" />
      <text>提交后订单会锁定，如需修改请联系客服</text>
    </view>
    <t-button
      theme="primary"
      size="large"
      block
      loading="{{isSubmitting}}"
      bind:tap="onSubmit"
    >
      提交订单
    </t-button>
  </view>

  <t-message id="t-message" />
</view>
