/**index.wxss**/
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fff9f0 0%, #ffffff 100%);
}

/* 顶部Banner区域 */
.header-banner {
  position: relative;
  padding: 80rpx 40rpx 80rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, #ff9900 0%, #ffcc00 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.banner-bg {
  position: absolute;
  top: -50%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 20rpx 40rpx;
  border-radius: 100rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  margin-right: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.banner-slogan {
  margin-bottom: 40rpx;
}

.slogan-main {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.order-button {
  width: 400rpx !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  background: #fff !important;
  color: #ff9900 !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15) !important;
}

/* ����������� */
.services-section {
  flex: 1;
  padding: 40rpx 32rpx;
  margin-top: -40rpx;
}

.section-title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #ff9900);
}

.title-line:last-child {
  background: linear-gradient(90deg, #ff9900, transparent);
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin: 0 24rpx;
}

.service-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.service-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.service-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.service-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.gradient-orange {
  background: linear-gradient(135deg, #ff9900, #ffcc00);
}

.gradient-pink {
  background: linear-gradient(135deg, #ff6b9d, #ff9a8b);
}

.gradient-green {
  background: linear-gradient(135deg, #36cfc9, #73d13d);
}

.gradient-purple {
  background: linear-gradient(135deg, #597ef7, #9254de);
}

.gradient-blue {
  background: linear-gradient(135deg, #40a9ff, #1890ff);
}

.gradient-yellow {
  background: linear-gradient(135deg, #ffc53d, #faad14);
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
}

.dev-tag {
  background: linear-gradient(135deg, #f0f0f0, #e8e8e8);
  color: #999;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.hot-tag {
  background: linear-gradient(135deg, #ff6b9d, #ff8fab);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 底部信息 */
.footer-info {
  padding: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}
