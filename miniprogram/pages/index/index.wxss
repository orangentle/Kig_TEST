/**index.wxss**/
.container {
  min-height: 100vh;
  position: relative;
  /* 多层径向渐变 + 主底色,让背景柔和不空 */
  background:
    radial-gradient(circle at 15% 10%, #ffe9c2 0%, transparent 28%),
    radial-gradient(circle at 88% 22%, #fdecd0 0%, transparent 30%),
    radial-gradient(circle at 78% 78%, #fff0d8 0%, transparent 32%),
    radial-gradient(circle at 10% 92%, #ffe2b8 0%, transparent 28%),
    #fdf8f0;
  overflow: hidden;
}

/* 背景装饰：飘浮圆形 + 爪印/星星 */
.bg-deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.55;
  filter: blur(2rpx);
}
.dc1 {
  width: 180rpx; height: 180rpx;
  background: radial-gradient(circle, #ffd8a8 0%, transparent 70%);
  top: 60rpx; left: -40rpx;
}
.dc2 {
  width: 140rpx; height: 140rpx;
  background: radial-gradient(circle, #ffe9c2 0%, transparent 70%);
  top: 200rpx; right: -30rpx;
}
.dc3 {
  width: 220rpx; height: 220rpx;
  background: radial-gradient(circle, #fdecd0 0%, transparent 70%);
  bottom: 100rpx; left: 30%;
}
.deco-paw {
  position: absolute;
  opacity: 0.5;
  color: #ff9020;
}
.p1 { top: 140rpx; right: 80rpx; font-size: 32rpx; transform: rotate(15deg); }
.p2 { top: 360rpx; left: 50rpx;  font-size: 28rpx; transform: rotate(-20deg); opacity: 0.4; }
.p3 { top: 100rpx; left: 50%;    font-size: 24rpx; }
.p4 { top: 280rpx; right: 30rpx; font-size: 20rpx; }
.p5 { top: 480rpx; left: 20%;    font-size: 22rpx; opacity: 0.45; }

/* 顶部Banner */
.header-banner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 60rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

/* Logo */
.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(168, 90, 21, 0.15);
  margin-bottom: 28rpx;
}

/* 标题：可爱手写感，每字微旋转 */
.title {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  font-family: "Hannotate SC", "HYWenHei-85W", "Yuanti SC", "STHupo", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

.title-char {
  font-size: 72rpx;
  font-weight: 700;
  color: #4a2810;
  line-height: 1;
  display: inline-block;
  transition: transform 0.3s ease;
}

.c1 { transform: rotate(-4deg) translateY(2rpx); color: #c25a1a; }
.c2 { transform: rotate(3deg)  translateY(-2rpx); color: #c25a1a; }
.c3 { transform: rotate(-2deg) translateY(2rpx); color: #4a2810; }
.c4 { transform: rotate(4deg)  translateY(-2rpx); color: #4a2810; }

/* 标题下方装饰：橙线 + 中间小星 */
.title-divider {
  position: relative;
  width: 88rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #ffaa33, transparent);
  border-radius: 999rpx;
  margin: 24rpx 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider-paw {
  position: absolute;
  font-size: 22rpx;
  color: #ff9020;
  background: transparent;
  padding: 0 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #a08060;
  letter-spacing: 6rpx;
  text-align: center;
}

/* 招呼语 */
.greeting {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #c25a1a;
  letter-spacing: 2rpx;
  background: #fff4e6;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx dashed #ffd8a8;
}

/* 主按钮 */
.order-button {
  margin-top: 36rpx;
  width: 360rpx !important;
  height: 88rpx !important;
  font-size: 30rpx !important;
  font-weight: 500 !important;
  letter-spacing: 6rpx !important;
  background: #ff9020 !important;
  color: #fff !important;
  border: none !important;
  border-radius: 999rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 144, 32, 0.25) !important;
}

/* 服务卡 */
.services-section {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 40rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

/* 北欧风卡片：白底、细边、极淡阴影、内容居中 */
.service-card {
  position: relative;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  padding: 44rpx 24rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;     /* 居中 */
  justify-content: center;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
  transition: all 0.2s ease;
  overflow: hidden;
}

.service-card:active {
  transform: scale(0.98);
  background: #fdf8f0;
}

.service-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;       /* 圆形图标底，更北欧 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 两组暖色：琥珀 / 奶油 */
.accent-amber { background: #ffe9c2; }
.accent-cream { background: #fdf0d8; }

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a2410;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

.service-desc {
  font-size: 22rpx;
  color: #a08060;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* 标签居中位置 */
.dev-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #f5efe4;
  color: #b09070;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.hot-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #ff9020;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 底部 */
.footer-info {
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #c8b09a;
  letter-spacing: 2rpx;
}

/* ============ 订单查询弹窗 ============ */
.query-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 36rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部 */
.query-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.query-icon-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9020 0%, #ffaa33 60%, #ffc266 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow:
    0 12rpx 24rpx rgba(255, 144, 32, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
}

.query-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3a2410;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.query-sub {
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

/* 输入框 */
.query-input-wrap {
  display: flex;
  align-items: center;
  background: #fdf8f0;
  border: 2rpx solid #f0e6d6;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 96rpx;
  transition: all 0.2s ease;
}

.query-input-wrap.has-error {
  border-color: #ff9a8b;
  background: #fff5f3;
}

.query-input-prefix {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff9020;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

.query-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #3a2410;
  letter-spacing: 1rpx;
}

.query-placeholder {
  color: #c8b09a;
  font-size: 28rpx;
}

.query-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.query-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ff4d4f;
  padding: 0 8rpx;
}

/* 演示订单 */
.query-demo {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed #f0e6d6;
}

.query-demo-label {
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

.query-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.query-chip {
  font-size: 22rpx;
  color: #c25a1a;
  background: #fff4e6;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ffd8a8;
  letter-spacing: 0.5rpx;
}

.query-chip:active {
  background: #ffe9c2;
  transform: scale(0.96);
}

/* 操作按钮 */
.query-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.query-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  transition: all 0.2s ease;
}

.query-btn-cancel {
  background: #fdf8f0;
  color: #8a6a4a;
  border: 1rpx solid #f0e6d6;
}

.query-btn-cancel:active {
  background: #f5efe4;
}

.query-btn-confirm {
  background: linear-gradient(135deg, #ff9020 0%, #ffaa33 100%);
  color: #fff;
  box-shadow:
    0 8rpx 20rpx rgba(255, 144, 32, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.query-btn-confirm:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 144, 32, 0.3);
}
