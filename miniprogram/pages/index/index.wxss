/**index.wxss**/
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.logo-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  -webkit-background-clip: text;
  color: transparent;
}

.search-box {
  border-radius: 12rpx;
  background-color: #f0f2f5;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.banner-area {
  height: 150rpx;
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.banner-content {
  z-index: 10;
}

.banner-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.banner-button {
  background-color: white !important;
  color: #ff8800 !important;
  border: none !important;
  font-size: 24rpx !important;
}

.banner-image {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  width: 180rpx;
  height: 180rpx;
  opacity: 0.2;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
}

.section-more {
  font-size: 24rpx;
  color: #ff8800;
}

.search-list {
  margin-bottom: 32rpx;
}

.search-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.search-item:active {
  transform: translateY(-2rpx);
}

.search-item-info {
  flex: 1;
}

.search-item-title {
  font-weight: 500;
  margin-bottom: 8rpx;
}

.search-item-desc {
  font-size: 24rpx;
  color: #999;
}

.search-item-action {
  background-color: #fff0e0;
  color: #ff8800;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
}

.search-button-container {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
  padding: 0 24rpx;
}

.search-button-container .t-button {
  min-width: 240rpx;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}
