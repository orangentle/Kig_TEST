<!--index.wxml-->
<view class="container">
  <!-- 顶部Banner区域 -->
  <view class="header-banner">
    <view class="banner-bg"></view>
    <view class="banner-content">
      <view class="logo-section">
        <image class="logo" src="/assets/images/icon.jpg" mode="aspectFill"></image>
        <view class="logo-text">
          <text class="title">鼠鼠工坊</text>
          <text class="subtitle">专业Kigurumi头壳定制</text>
        </view>
      </view>
      <view class="banner-slogan">
        <text class="slogan-main">精心打造，为您的角色赋予生命</text>
      </view>
      <t-button 
        theme="primary" 
        size="large" 
        shape="round" 
        icon="edit"
        class="order-button"
        bind:tap="goToOrder"
      >
        立即定制
      </t-button>
    </view>
  </view>
  
  <!-- 服务入口 -->
  <view class="services-section">
    <view class="section-title-bar">
      <view class="title-line"></view>
      <text class="title-text">我们的服务</text>
      <view class="title-line"></view>
    </view>
    
    <view class="service-grid">
      <!-- 头壳下单 -->
      <view class="service-card" bindtap="goToOrder">
        <view class="service-icon-wrap gradient-orange">
          <t-icon name="edit" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">头壳下单</text>
          <text class="service-desc">定制专属Kig头壳</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#ccc" />
      </view>
      
      <!-- 偶壳娃聚 -->
      <view class="service-card" bindtap="showDeveloping">
        <view class="service-icon-wrap gradient-pink">
          <t-icon name="heart" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">偶壳娃聚</text>
          <text class="service-desc">社区活动聚会</text>
        </view>
        <view class="dev-tag">开发中</view>
      </view>
      
      <!-- 作品展示 -->
      <view class="service-card" bindtap="goToWorks">
        <view class="service-icon-wrap gradient-green">
          <t-icon name="image" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">作品展示</text>
          <text class="service-desc">浏览精选作品集</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#ccc" />
      </view>
      
      <!-- 我的订单 -->
      <view class="service-card" bindtap="goToProfile">
        <view class="service-icon-wrap gradient-purple">
          <t-icon name="user" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">我的订单</text>
          <text class="service-desc">查看订单进度</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#ccc" />
      </view>
      
      <!-- 常见问题 -->
      <view class="service-card" bindtap="showDeveloping">
        <view class="service-icon-wrap gradient-blue">
          <t-icon name="help-circle" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">常见问题</text>
          <text class="service-desc">FAQ帮助中心</text>
        </view>
        <view class="dev-tag">开发中</view>
      </view>
      
      <!-- 价格估算 -->
      <view class="service-card" bindtap="showDeveloping">
        <view class="service-icon-wrap gradient-yellow">
          <t-icon name="calculation" size="56rpx" color="#fff" />
        </view>
        <view class="service-info">
          <text class="service-name">价格估算</text>
          <text class="service-desc">在线估算费用</text>
        </view>
        <view class="dev-tag">开发中</view>
      </view>
    </view>
  </view>
  
  <!-- 底部信息 -->
  <view class="footer-info">
    <text class="footer-text">© 2025 鼠鼠工坊 · 用心定制每一个头壳</text>
  </view>
</view>
