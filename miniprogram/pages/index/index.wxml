<!--index.wxml-->
<view class="container">
  <!-- 背景装饰（精简：保留两枚爪印 + 一颗星）-->
  <view class="bg-deco">
    <view class="deco-circle dc1"></view>
    <view class="deco-circle dc2"></view>
    <view class="deco-circle dc3"></view>
    <text class="deco-paw p1">🐾</text>
    <text class="deco-paw p2">🐾</text>
    <text class="deco-paw p3">✦</text>
  </view>

  <!-- 顶部Banner -->
  <view class="header-banner">
    <image wx:if="{{logoUrl}}" class="logo" src="{{logoUrl}}" mode="aspectFit"></image>
    <view wx:else class="logo logo-placeholder">
      <t-icon name="image" size="80rpx" color="#d8c8b0" />
    </view>
    <view class="title">
      <text class="title-char c1">鼠</text>
      <text class="title-char c2">鼠</text>
      <text class="title-char c3">工</text>
      <text class="title-char c4">坊</text>
    </view>
    <view class="title-divider">
      <text class="divider-paw">✦</text>
    </view>
    <text class="subtitle">Kigurumi 头壳定制</text>

    <text class="greeting">欢迎来到鼠鼠的小窝~ 🐭✨</text>

    <t-button
      theme="primary"
      size="large"
      shape="round"
      icon="edit"
      class="order-button"
      bind:tap="goToOrder"
    >
      立即定制
    </t-button>
  </view>

  <!-- 服务入口 -->
  <view class="services-section">
    <view class="service-grid">
      <view class="service-card" bindtap="queryOrder">
        <view class="service-icon-wrap accent-amber">
          <t-icon name="search" size="48rpx" color="#a85a15" />
        </view>
        <text class="service-name">订单查询</text>
        <text class="service-desc">凭单号查看进度</text>
      </view>

      <view class="service-card" bindtap="showDeveloping">
        <view class="service-icon-wrap accent-cream">
          <t-icon name="help-circle" size="48rpx" color="#c87a1a" />
        </view>
        <text class="service-name">常见问题</text>
        <text class="service-desc">FAQ 帮助中心</text>
        <view class="dev-tag">开发中</view>
      </view>

      <view class="service-card" bindtap="showDeveloping">
        <view class="service-icon-wrap accent-cream">
          <t-icon name="calculation" size="48rpx" color="#c87a1a" />
        </view>
        <text class="service-name">价格估算</text>
        <text class="service-desc">在线估算费用</text>
        <view class="dev-tag">开发中</view>
      </view>

      <view class="service-card" bindtap="goToGathering">
        <view class="service-icon-wrap accent-amber">
          <t-icon name="heart" size="48rpx" color="#a85a15" />
        </view>
        <text class="service-name">偶壳娃聚</text>
        <text class="service-desc">社区活动聚会</text>
        <view class="hot-tag">热门</view>
      </view>
    </view>
  </view>

  <!-- 信息模块：定制流程 / 排单状态 / FAQ -->
  <view class="info-section">
    <view class="info-block">
      <view class="info-title">定制流程</view>
      <view class="flow-list">
        <view class="flow-step">
          <view class="flow-num">1</view>
          <text class="flow-name">已排单</text>
          <text class="flow-desc">付定金</text>
        </view>
        <view class="flow-step">
          <view class="flow-num">2</view>
          <text class="flow-name">建模</text>
          <text class="flow-desc">头壳成型</text>
        </view>
        <view class="flow-step">
          <view class="flow-num">3</view>
          <text class="flow-name">上妆</text>
          <text class="flow-desc">面部彩绘</text>
        </view>
        <view class="flow-step">
          <view class="flow-num">4</view>
          <text class="flow-name">假毛</text>
          <text class="flow-desc">植毛造型</text>
        </view>
        <view class="flow-step">
          <view class="flow-num">5</view>
          <text class="flow-name">已发货</text>
          <text class="flow-desc">尾款顺丰</text>
        </view>
      </view>
    </view>

    <view class="info-block">
      <view class="info-title">当前排单</view>
      <view class="queue-row">
        <text class="queue-label"><text class="queue-status-dot dot-busy"></text>U 类常规</text>
        <text class="queue-value">约 150 个工作日</text>
      </view>
      <view class="queue-row">
        <text class="queue-label"><text class="queue-status-dot dot-open"></text>U 类加急</text>
        <text class="queue-value">约 60 个工作日</text>
      </view>
    </view>

    <view class="info-block">
      <view class="info-title">常见问题</view>
      <view class="faq-item">
        <view class="faq-q">如何下单？</view>
        <view class="faq-a">点击「立即定制」填写需求，我们会在 24 小时内联系确认。</view>
      </view>
      <view class="faq-item">
        <view class="faq-q">价格如何核算？</view>
        <view class="faq-a">根据尺寸、材质、工艺复杂度报价，沟通后会给出明细。</view>
      </view>
      <view class="faq-item">
        <view class="faq-q">能否售后维修？</view>
        <view class="faq-a">支持基础维修和清洁，发货 30 天内非人为损坏免费返修。</view>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer-info">
    <text class="footer-text">© 2025 鼠鼠工坊</text>
  </view>

  <!-- 订单查询弹窗 -->
  <t-popup visible="{{showQueryPopup}}" placement="center" bind:visible-change="onQueryPopupClose">
    <view class="query-modal" catchtap="">
      <!-- 顶部装饰 -->
      <view class="query-header">
        <view class="query-icon-circle">
          <t-icon name="search" size="56rpx" color="#fff" />
        </view>
        <text class="query-title">订单查询</text>
        <text class="query-sub">输入淘宝订单号查看制作进度</text>
      </view>

      <!-- 输入框 -->
      <view class="query-input-wrap {{queryError ? 'has-error' : ''}}">
        <text class="query-input-prefix">TB</text>
        <input
          class="query-input"
          placeholder="请输入订单号"
          placeholder-class="query-placeholder"
          value="{{queryValue}}"
          bindinput="onQueryInput"
          confirm-type="search"
          bindconfirm="onQuerySubmit"
        />
        <view wx:if="{{queryValue}}" class="query-clear" catchtap="onQueryClear">
          <t-icon name="close-circle-filled" size="36rpx" color="#d8c8b0" />
        </view>
      </view>

      <view wx:if="{{queryError}}" class="query-error">
        <t-icon name="info-circle-filled" size="26rpx" color="#ff4d4f" />
        <text>{{queryError}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="query-actions">
        <view class="query-btn query-btn-cancel" bindtap="onQueryPopupClose">取消</view>
        <view class="query-btn query-btn-confirm {{isQuerying ? 'is-loading' : ''}}" bindtap="onQuerySubmit">
          <t-icon wx:if="{{!isQuerying}}" name="search" size="32rpx" color="#fff" />
          <text>{{isQuerying ? '查询中...' : '立即查询'}}</text>
        </view>
      </view>
    </view>
  </t-popup>
</view>
