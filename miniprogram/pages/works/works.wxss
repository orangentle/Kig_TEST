/* works.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-primary-bg) 30%, var(--color-bg) 100%);
}

.header {
  background: var(--color-card);
  padding: 32rpx 28rpx 16rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  box-shadow: 0 4rpx 18rpx rgba(232, 114, 42, 0.06);
  position: relative;
  z-index: 2;
  border-radius: 0 0 28rpx 28rpx;
}

.header-title {
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
  font-family: "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
}

.header-sub {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin: 6rpx 0 18rpx;
  letter-spacing: 2rpx;
}

.search-box { margin-bottom: 16rpx; }

.sort-options {
  display: flex;
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.sort-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: var(--color-primary-bg);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-divider);
  letter-spacing: 1rpx;
  transition: all 0.2s ease;
}

.sort-item:last-child { margin-right: 28rpx; }

.sort-active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(232, 114, 42, 0.28);
}

.works-container {
  flex: 1;
  padding: 24rpx 24rpx 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.work-card {
  background: var(--color-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-divider);
  transition: all 0.25s ease;
}

.work-card:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.work-image-container {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background: var(--color-primary-bg);
}

.work-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.work-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fdf6ec;
}

.cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}
.cat-original { background: rgba(255, 140, 58, 0.92); }
.cat-game     { background: rgba(232, 114, 42, 0.92); }
.cat-anime    { background: rgba(194, 90, 26, 0.92); }

.work-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 18rpx 14rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
}

.work-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.work-info {
  padding: 14rpx 20rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.work-source-wrap {
  flex: 1;
  min-width: 0;
  margin-right: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}

.work-source {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  display: inline-block;
  will-change: transform;
}

.work-source-wrap.marquee .work-source {
  animation-name: source-pingpong;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes source-pingpong {
  0%   { transform: translateX(0); }
  10%  { transform: translateX(0); }
  90%  { transform: translateX(var(--scroll-distance, 0)); }
  100% { transform: translateX(var(--scroll-distance, 0)); }
}

.work-date {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-card {
  pointer-events: none;
}
.skeleton-image {
  width: 100%;
  padding-top: 100%;
  background: linear-gradient(90deg, var(--color-primary-bg) 25%, var(--color-deco-soft) 50%, var(--color-primary-bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
.skeleton-info {
  padding: 16rpx 20rpx 22rpx;
}
.skeleton-line {
  height: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--color-primary-bg) 25%, var(--color-deco-soft) 50%, var(--color-primary-bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
  margin-bottom: 10rpx;
}
.skeleton-line.w-60 { width: 60%; }
.skeleton-line.w-40 { width: 40%; }
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.load-more {
  text-align: center;
  margin: 32rpx 0 16rpx;
}

.load-more-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 44rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-divider);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(200, 153, 104, 0.12);
  transition: all 0.18s ease;
}

.load-more-btn-hover {
  background: var(--color-primary-bg);
  border-color: var(--color-primary-light);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(200, 153, 104, 0.18);
}

.load-more-paw {
  font-size: 26rpx;
  line-height: 1;
}

.load-more-text {
  font-size: 26rpx;
  color: var(--color-deco-warm);
  font-weight: 600;
  letter-spacing: 4rpx;
  font-family: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.empty-action {
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(232, 114, 42, 0.25);
}
.empty-action:active { opacity: 0.85; }
