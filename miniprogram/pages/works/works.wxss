/* works.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fff7ed 0%, #fef3e2 30%, #fdf8f0 100%);
}

.header {
  background: #ffffff;
  padding: 32rpx 28rpx 16rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  box-shadow: 0 4rpx 18rpx rgba(255, 144, 32, 0.06);
  position: relative;
  z-index: 2;
  border-radius: 0 0 28rpx 28rpx;
}

.header-title {
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #3a2410;
  letter-spacing: 2rpx;
  font-family: "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
}

.header-sub {
  text-align: center;
  font-size: 22rpx;
  color: #b09280;
  margin: 6rpx 0 18rpx;
  letter-spacing: 2rpx;
}

.search-box { margin-bottom: 16rpx; }

.sort-options {
  display: flex;
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.sort-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #fdf3e3;
  color: #a08060;
  border: 1rpx solid #f5e3c8;
  letter-spacing: 1rpx;
  transition: all 0.2s ease;
}

.sort-item:last-child { margin-right: 28rpx; }

.sort-active {
  background: linear-gradient(135deg, #ff8800, #ffaa33);
  color: #fff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255, 136, 0, 0.28);
}

.works-container {
  flex: 1;
  padding: 24rpx 24rpx 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.work-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(168, 90, 21, 0.06);
  border: 1rpx solid #f5ebd9;
  transition: all 0.25s ease;
}

.work-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 22rpx rgba(168, 90, 21, 0.12);
}

.work-image-container {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background: #fdf3e3;
}

.work-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}
.cat-original { background: rgba(255, 136, 0, 0.92); }
.cat-game     { background: rgba(82, 130, 224, 0.92); }
.cat-anime    { background: rgba(214, 75, 130, 0.92); }

.work-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 18rpx 14rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
}

.work-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.work-info {
  padding: 14rpx 20rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.work-source {
  font-size: 22rpx;
  color: #8a6a4a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}

.work-date {
  font-size: 22rpx;
  color: #b8a890;
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-card {
  pointer-events: none;
}
.skeleton-image {
  width: 100%;
  padding-top: 100%;
  background: linear-gradient(90deg, #fdf3e3 25%, #fbe9cc 50%, #fdf3e3 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
.skeleton-info {
  padding: 16rpx 20rpx 22rpx;
}
.skeleton-line {
  height: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #fdf3e3 25%, #fbe9cc 50%, #fdf3e3 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
  margin-bottom: 10rpx;
}
.skeleton-line.w-60 { width: 60%; }
.skeleton-line.w-40 { width: 40%; }
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.load-more {
  text-align: center;
  margin: 24rpx 0 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  color: #a08060;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.empty-action {
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8800, #ffaa33);
  color: #fff;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 136, 0, 0.25);
}
.empty-action:active { opacity: 0.85; }
