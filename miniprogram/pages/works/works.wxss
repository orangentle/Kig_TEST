/* works.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.search-box {
  margin-bottom: 24rpx;
}

.sort-options {
  display: flex;
  white-space: nowrap;
  margin-top: 16rpx;
}

.sort-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: #f5f5f5;
  color: #666;
}

.sort-active {
  background-color: #fff0e0;
  color: #ff8800;
}

.works-container {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.work-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.work-card:active {
  transform: translateY(-4rpx);
}

.work-image-container {
  position: relative;
  height: 320rpx;
}

.work-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.work-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
}

.work-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.work-info {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.work-source, .work-date {
  font-size: 24rpx;
  color: #999;
}

.load-more {
  text-align: center;
  margin: 32rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
} 