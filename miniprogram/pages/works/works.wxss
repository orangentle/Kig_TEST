/* works.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.header {
  background-color: #ffffff;
  padding: 32rpx 28rpx 20rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
}

.header-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.search-box {
  margin-bottom: 20rpx;
}

.sort-options {
  display: flex;
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.sort-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background-color: #f2f3f5;
  color: #5a5a5a;
  transition: all 0.2s ease;
}

.sort-item:last-child {
  margin-right: 28rpx;
}

.sort-active {
  background: linear-gradient(135deg, #ff8800, #ffaa33);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(255, 136, 0, 0.28);
}

.works-container {
  flex: 1;
  padding: 24rpx 24rpx 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.work-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.25s ease;
}

.work-card:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

.work-image-container {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background: #f5f5f5;
}

.work-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.work-title-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 18rpx 14rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
}

.work-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.work-info {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.work-source {
  font-size: 22rpx;
  color: #6a6a6a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}

.work-date {
  font-size: 22rpx;
  color: #a8a8a8;
  flex-shrink: 0;
}

.load-more {
  text-align: center;
  margin: 24rpx 0 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  opacity: 0.45;
  border-radius: 50%;
}

.empty-text {
  color: #999;
  font-size: 26rpx;
}
