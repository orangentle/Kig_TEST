<!--works.wxml-->
<view class="container">
  <!-- 顶部搜索和筛选 -->
  <view class="header">
    <view class="header-title">作品橱窗 ✨</view>
    <view class="header-sub">鼠鼠工坊出窝的宝贝们~</view>

    <!-- 搜索框 -->
    <view class="search-box">
      <t-search
        value="{{searchValue}}"
        placeholder="搜搜角色名或来源作品~"
        bind:change="onSearchChange"
        bind:submit="onSearch"
      />
    </view>

    <!-- 排序选项 -->
    <scroll-view scroll-x class="sort-options" enhanced show-scrollbar="{{false}}">
      <view class="sort-item {{currentSort === 'latest' ? 'sort-active' : ''}}" bindtap="onSortChange" data-sort="latest">最新</view>
      <view class="sort-item {{currentSort === 'name' ? 'sort-active' : ''}}" bindtap="onSortChange" data-sort="name">名称</view>
      <view class="sort-item {{currentSort === 'original' ? 'sort-active' : ''}}" bindtap="onSortChange" data-sort="original">自设</view>
      <view class="sort-item {{currentSort === 'game' ? 'sort-active' : ''}}" bindtap="onSortChange" data-sort="game">游戏</view>
      <view class="sort-item {{currentSort === 'anime' ? 'sort-active' : ''}}" bindtap="onSortChange" data-sort="anime">动漫</view>
    </scroll-view>
  </view>

  <!-- 作品展示区 -->
  <view class="works-container">

    <!-- 骨架屏 -->
    <view class="works-grid" wx:if="{{isLoading}}">
      <view class="work-card skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
        <view class="skeleton-image"></view>
        <view class="skeleton-info">
          <view class="skeleton-line w-60"></view>
          <view class="skeleton-line w-40"></view>
        </view>
      </view>
    </view>

    <!-- 作品网格 -->
    <view class="works-grid" wx:elif="{{displayedWorks.length > 0}}">
      <view
        class="work-card"
        wx:for="{{displayedWorks}}"
        wx:key="id"
        bindtap="onWorkClick"
        data-work-id="{{item.id}}"
      >
        <view class="work-image-container">
          <image
            wx:if="{{item.imageUrl}}"
            class="work-image"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            lazy-load="true"
          ></image>
          <view wx:else class="work-image work-image-placeholder">
            <t-icon name="image" size="80rpx" color="#d8c8b0" />
          </view>
          <view class="cat-badge cat-{{item.category}}">{{item.categoryLabel}}</view>
          <view class="work-title-overlay">
            <text class="work-title">{{item.roleName}}</text>
          </view>
        </view>
        <view class="work-info">
          <view class="work-source-wrap {{item.needScroll ? 'marquee' : ''}}" id="src-wrap-{{index}}">
            <text class="work-source" id="src-text-{{index}}" style="{{item.needScroll ? '--scroll-distance:' + item.scrollDistance + 'px; animation-duration:' + item.scrollDuration + 's' : ''}}">来源: {{item.source}}</text>
          </view>
          <text class="work-date">{{item.date}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多按钮 -->
    <view class="load-more" wx:if="{{!isLoading && hasMore}}">
      <view class="load-more-btn" hover-class="load-more-btn-hover" bind:tap="loadMore">
        <text class="load-more-text">多来点 求求了 ↓</text>
      </view>
    </view>

    <!-- 加载失败 -->
    <view class="empty-state" wx:if="{{!isLoading && loadFailed}}">
      <view class="empty-emoji">📡</view>
      <text class="empty-text">信号迷路了 (´·ω·`)</text>
      <view class="empty-action" bindtap="onRetryLoad">点我再试一次</view>
    </view>

    <!-- 空数据状态 -->
    <view class="empty-state" wx:if="{{!isLoading && !loadFailed && displayedWorks.length === 0}}">
      <view class="empty-emoji">🐭</view>
      <text class="empty-text">还没找到合适的~ 换个关键词试试?</text>
    </view>
  </view>
</view>
