<view class="container">
  <view class="hero" bindtap="previewCover">
    <image
      wx:if="{{work.coverFileId}}"
      class="cover {{panDistance < 0 ? 'cover-pan' : ''}}"
      style="{{panDistance < 0 ? '--pan-distance: ' + panDistance + 'rpx;' : ''}}"
      src="{{work.coverFileId}}"
      mode="{{coverMode}}"
    />
    <view wx:else class="cover cover-placeholder">
      <t-icon name="image" size="120rpx" color="#d8c8b0" />
    </view>
    <view class="hero-mask"></view>
    <view wx:if="{{work.coverFileId && panDistance < 0}}" class="hero-zoom-hint">
      <t-icon name="zoom-in" size="28rpx" color="#fff" />
      <text>点击查看大图</text>
    </view>
    <view class="hero-info">
      <view class="hero-title">{{work.roleName}}</view>
      <view class="hero-source">来源 · {{work.source}}</view>
    </view>
  </view>

  <view class="content">
    <view class="info-card">
      <view class="info-row">
        <view class="info-label">
          <t-icon name="tag" size="32rpx" color="#ff8800" />
          <text>分类</text>
        </view>
        <view class="info-value">{{work.categoryLabel || '未分类'}}</view>
      </view>
      <view class="divider"></view>
      <view class="info-row">
        <view class="info-label">
          <t-icon name="time" size="32rpx" color="#ff8800" />
          <text>完成时间</text>
        </view>
        <view class="info-value">{{work.date}}</view>
      </view>
      <view class="divider"></view>
      <view class="info-row">
        <view class="info-label">
          <t-icon name="money" size="32rpx" color="#ff8800" />
          <text>参考价格</text>
        </view>
        <view class="info-value price">
          <text wx:if="{{work.price !== undefined && work.price !== null}}">¥ {{work.price}}</text>
          <text wx:else class="placeholder">未公开</text>
        </view>
      </view>
    </view>

    <view class="tip-card">
      <t-icon name="info-circle" size="32rpx" color="#ff8800" />
      <text class="tip-text">每件作品均为手工定制,价格依角色复杂度浮动,详情请咨询客服。</text>
    </view>
  </view>

  <view class="action-bar">
    <t-button
      theme="primary"
      size="large"
      block
      shape="round"
      class="primary-button"
      bind:tap="goToOrder"
    >我也想定制同款</t-button>
  </view>
</view>
