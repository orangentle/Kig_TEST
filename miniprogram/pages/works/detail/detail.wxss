.container {
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部图片区 */
.hero {
  position: relative;
  width: 100%;
  height: 720rpx;
  background: #1a1a1a;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2a2a2a;
}

/* 长图自动上下浮动：mode=widthFix 时图片高度可超出容器，
   --pan-distance 是 ts 计算出的负向 rpx 偏移量。 */
.cover-pan {
  width: 100%;
  height: auto;
  animation: heroPanY 7s ease-in-out infinite alternate;
  will-change: transform;
}

@keyframes heroPanY {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(0, var(--pan-distance, 0rpx), 0); }
}

.hero-zoom-hint {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8rpx);
  z-index: 3;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 50%, rgba(0,0,0,0.7) 100%);
}

.hero-info {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 8rpx;
}

.hero-source {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.5rpx;
}

/* 内容区 */
.content {
  padding: 24rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  box-shadow: var(--shadow-md);
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.info-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.info-label t-icon {
  margin-right: 12rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.info-value.price {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 30rpx;
}

.info-value .placeholder {
  color: var(--color-text-tertiary);
  font-weight: 400;
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  background: var(--color-divider);
}

/* 提示卡片 */
.tip-card {
  background: linear-gradient(135deg, #fff8ed, #fff2dc);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
  border: 1rpx solid #ffe6c2;
}

.tip-card t-icon {
  margin-right: 12rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #b56a00;
  line-height: 1.6;
  flex: 1;
}

/* 底部行动栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}
