/* gathering/gathering.wxss - 偶壳娃聚主页样式 */

.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 顶部Banner */
.header-banner {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.banner-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--color-gathering-1), var(--color-primary));
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
}

.banner-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 功能入口网格 */
.function-grid {
  padding: 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.function-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.bg-pink {
  background: linear-gradient(135deg, var(--color-gathering-1), var(--color-primary-light));
}

.bg-blue {
  background: linear-gradient(135deg, var(--color-gathering-2), var(--color-deco-warm));
}

.bg-orange {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
}

.bg-green {
  background: linear-gradient(135deg, var(--color-gathering-3), var(--color-warning));
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.card-badge {
  background: var(--color-primary);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.card-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.card-tag.hot {
  background: #fff1f0;
  color: var(--color-danger);
}

/* 区块样式 */
.section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-more {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 活动列表 */
.event-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.event-card {
  display: flex;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.event-card:last-child {
  border-bottom: none;
}

.event-date {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  margin-right: 24rpx;
}

.date-month {
  font-size: 24rpx;
  opacity: 0.9;
}

.date-day {
  font-size: 40rpx;
  font-weight: bold;
}

.event-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.event-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.event-location {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.event-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.event-spots {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.event-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.event-status.open {
  background: #f6ffed;
  color: var(--color-success);
}

.event-status.upcoming {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.event-status.closed {
  background: var(--color-bg);
  color: var(--color-text-tertiary);
}

/* 照片滚动 */
.photo-scroll {
  white-space: nowrap;
}

.photo-item {
  display: inline-block;
  width: 240rpx;
  height: 240rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.photo-event {
  font-size: 22rpx;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-state.small {
  padding: 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

/* 我的报名 */
.signup-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.signup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.signup-item:last-child {
  border-bottom: none;
}

.signup-info {
  display: flex;
  flex-direction: column;
}

.signup-event {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.signup-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.signup-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.signup-status.confirmed {
  background: #f6ffed;
  color: var(--color-success);
}

.signup-status.pending {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.signup-status.cancelled {
  background: var(--color-bg);
  color: var(--color-text-tertiary);
}
