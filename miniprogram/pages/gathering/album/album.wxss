/* pages/gathering/album/album.wxss */

.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 120rpx;
}

/* 相册分类标签 */
.album-tabs {
  background: #fff;
  white-space: nowrap;
  padding: 0;
}

.tabs-inner {
  display: inline-flex;
  padding: 24rpx;
}

.tab-item {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: var(--color-bg);
  border-radius: 32rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-weight: 500;
}

/* 相册列表 */
.album-list {
  padding: 24rpx;
}

.album-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.album-cover {
  position: relative;
}

.album-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.album-info {
  display: flex;
  flex-direction: column;
}

.album-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.album-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.album-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 照片瀑布流 */
.photo-waterfall {
  display: flex;
  padding: 16rpx;
}

.waterfall-column {
  flex: 1;
  padding: 8rpx;
}

.photo-item {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.photo-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  display: flex;
  justify-content: flex-end;
}

.photo-actions .action-btn {
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 24rpx;
}

.photo-actions .action-btn text {
  margin-left: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  margin-top: 20rpx;
}

/* 上传提示 */
.upload-tip {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-content {
  display: flex;
  align-items: center;
  padding: 16rpx 40rpx;
  background: var(--color-primary-bg);
  border-radius: 32rpx;
  border: 2rpx solid var(--color-primary);
}

.tip-content text {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-left: 8rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
}

/* 照片详情弹窗 */
.photo-detail-popup {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.detail-user {
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.upload-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.detail-close {
  padding: 8rpx;
}

.detail-image {
  background: var(--color-bg);
  min-height: 400rpx;
  max-height: 60vh;
  overflow: hidden;
}

.detail-content {
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  border-bottom: 1rpx solid var(--color-divider);
}

.detail-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.action-item text {
  margin-top: 8rpx;
}
