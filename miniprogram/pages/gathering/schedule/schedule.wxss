/* pages/gathering/schedule/schedule.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background: #fff;
}

.month-arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 40rpx;
}

.month-year {
  font-size: 24rpx;
  color: #999;
}

.month-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 日历卡片 */
.calendar-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.calendar-header {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}

.calendar-body {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

.calendar-day.other-month .day-num {
  color: #ccc;
}

.calendar-day.today {
  background: #fff7e6;
  border-radius: 12rpx;
}

.calendar-day.today .day-num {
  color: #ff8800;
  font-weight: bold;
}

.calendar-day.selected {
  background: linear-gradient(135deg, #ff8800, #ffaa00);
  border-radius: 12rpx;
}

.calendar-day.selected .day-num {
  color: #fff;
  font-weight: bold;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff8800;
  border-radius: 50%;
  margin-top: 4rpx;
}

.calendar-day.selected .event-dot {
  background: #fff;
}

/* 区块 */
.section {
  padding: 0 24rpx;
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 日程列表 */
.schedule-list {
  background: transparent;
}

.schedule-item {
  display: flex;
  margin-bottom: 20rpx;
}

.schedule-time {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.time-start {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.time-line {
  width: 2rpx;
  flex: 1;
  background: #e0e0e0;
  margin: 8rpx 0;
}

.time-end {
  font-size: 24rpx;
  color: #999;
}

.schedule-content {
  flex: 1;
  margin-left: 16rpx;
}

.schedule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #ff8800;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.schedule-card.gathering {
  border-left-color: #ff8800;
}

.schedule-card.photo {
  border-left-color: #5b8def;
}

.schedule-card.workshop {
  border-left-color: #52c41a;
}

.schedule-card.market {
  border-left-color: #ff6b9d;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.schedule-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.schedule-type-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: #fff7e6;
  color: #ff8800;
  border-radius: 16rpx;
}

.schedule-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

/* 近期活动 */
.upcoming-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.upcoming-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.upcoming-item:last-child {
  border-bottom: none;
}

.upcoming-date {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}

.date-month {
  font-size: 22rpx;
  color: #999;
}

.date-day {
  font-size: 44rpx;
  font-weight: bold;
  color: #ff8800;
}

.date-weekday {
  font-size: 22rpx;
  color: #999;
}

.upcoming-info {
  flex: 1;
}

.upcoming-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.upcoming-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.upcoming-location {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.upcoming-location text {
  margin-left: 8rpx;
}

.upcoming-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.upcoming-type {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.upcoming-type.gathering {
  background: #fff7e6;
  color: #ff8800;
}

.upcoming-type.photo {
  background: #e6f4ff;
  color: #5b8def;
}

.upcoming-type.workshop {
  background: #f6ffed;
  color: #52c41a;
}

.upcoming-type.market {
  background: #fff1f0;
  color: #ff6b9d;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-state.small {
  padding: 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 详情弹窗 */
.detail-popup {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.detail-close {
  padding: 8rpx;
}

.detail-content {
  flex: 1;
  max-height: 60vh;
}

.detail-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-row-content {
  flex: 1;
  margin-left: 16rpx;
}

.row-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.row-value {
  font-size: 28rpx;
  color: #333;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.agenda-list {
  margin-top: 8rpx;
}

.agenda-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.agenda-item:last-child {
  border-bottom: none;
}

.agenda-time {
  min-width: 160rpx;
  font-size: 26rpx;
  color: #ff8800;
  font-weight: 500;
  flex-shrink: 0;
}

.agenda-content {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  white-space: pre-wrap;
  line-height: 1.6;
}

.detail-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff8800, #ffaa00);
  color: #fff;
}
