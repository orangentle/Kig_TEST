/* pages/gathering/signup/signup.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 报名须知 */
.notice-card {
  margin: 24rpx;
  background: linear-gradient(135deg, #fff9f0, #fff5e6);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #ffe4c4;
}

.notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.notice-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #ff8800;
  margin-left: 12rpx;
}

.notice-close {
  padding: 8rpx;
}

.notice-content {
  padding-left: 52rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

/* 区块 */
.section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #ff8800;
}

/* 筛选 */
.filter-wrap {
  display: flex;
  align-items: center;
}

.filter-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
}

.filter-btn text {
  margin-right: 8rpx;
}

/* 活动列表 */
.event-list {
  background: transparent;
}

.event-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.event-cover {
  position: relative;
  margin-right: 24rpx;
}

.event-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
}

.event-badge.open {
  background: #52c41a;
}

.event-badge.upcoming {
  background: #fa8c16;
}

.event-badge.closed {
  background: #999;
}

.event-badge.full {
  background: #ff4d4f;
}

.event-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.event-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.event-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.event-fee {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.event-fee.free {
  color: #52c41a;
  font-size: 28rpx;
}

.signup-btn {
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #ff8800, #ffaa00);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  line-height: 1.5;
}

.signup-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

/* 我的报名列表 */
.my-signup-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.my-signup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.my-signup-item:last-child {
  border-bottom: none;
}

.signup-left {
  flex: 1;
}

.signup-event-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.signup-time {
  font-size: 24rpx;
  color: #999;
}

.signup-right {
  display: flex;
  align-items: center;
}

.signup-status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
}

.signup-status-tag.confirmed {
  background: #f6ffed;
  color: #52c41a;
}

.signup-status-tag.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.signup-status-tag.cancelled {
  background: #f5f5f5;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-state.small {
  padding: 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 详情弹窗 */
.detail-popup {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.detail-close {
  padding: 8rpx;
}

.detail-content {
  flex: 1;
  max-height: 60vh;
}

.detail-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-row-content {
  flex: 1;
  margin-left: 16rpx;
}

.row-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.row-value {
  font-size: 28rpx;
  color: #333;
}

.row-value.free {
  color: #52c41a;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-top: 16rpx;
}

.detail-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff8800, #ffaa00);
  color: #fff;
}

.action-btn.disabled {
  background: #e0e0e0;
  color: #999;
}
