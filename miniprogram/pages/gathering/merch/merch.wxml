<!--pages/gathering/merch/merch.wxml - 鼠鼠周边页面-->
<view class="container">
  <!-- 自定义导航栏 -->
  <t-navbar title="鼠鼠周边" left-arrow bind:go-back="goBack" />
  
  <!-- 顶部Banner -->
  <view class="banner-section">
    <swiper class="banner-swiper" autoplay circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item" bindtap="onBannerTap" data-item="{{item}}">
          <t-image src="{{item.imageUrl}}" mode="aspectFill" width="100%" height="300rpx" />
          <view class="banner-overlay">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-desc">{{item.desc}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  
  <!-- 分类导航 -->
  <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view 
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="selectCategory"
        data-id="{{item.id}}"
      >
        <t-icon name="{{item.icon}}" size="40rpx" />
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
  
  <!-- 商品列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{currentCategoryName}}</text>
      <view class="sort-wrap" bindtap="showSortOptions">
        <text>{{currentSort.label}}</text>
        <t-icon name="chevron-down" size="28rpx" />
      </view>
    </view>
    
    <view class="product-grid" wx:if="{{products.length > 0}}">
      <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="showProductDetail" data-product="{{item}}">
        <view class="product-image-wrap">
          <t-image src="{{item.imageUrl}}" mode="aspectFill" width="100%" height="320rpx" shape="round" />
          <view class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
        </view>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.desc}}</view>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{item.price}}</text>
              <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="product-sales">已售 {{item.sales}}</view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <t-empty icon="shop" description="暂无商品" />
    </view>
  </view>
  
  <!-- 底部提示 -->
  <view class="footer-tip">
    <t-icon name="info-circle" size="28rpx" color="#999" />
    <text>所有周边商品均为娃聚活动限定，仅限活动期间购买</text>
  </view>
</view>

<!-- 商品详情弹窗 -->
<t-popup visible="{{showDetail}}" placement="bottom" bind:visible-change="onDetailClose">
  <view class="detail-popup">
    <view class="detail-header">
      <text class="detail-title">商品详情</text>
      <view class="detail-close" bindtap="closeDetail">
        <t-icon name="close" size="40rpx" color="#999" />
      </view>
    </view>
    <scroll-view scroll-y class="detail-content">
      <swiper class="detail-swiper" indicator-dots indicator-color="rgba(0,0,0,0.2)" indicator-active-color="#ff8800">
        <swiper-item wx:for="{{currentProduct.images}}" wx:key="*this">
          <t-image src="{{item}}" mode="aspectFill" width="100%" height="600rpx" />
        </swiper-item>
      </swiper>
      
      <view class="detail-info">
        <view class="detail-name">{{currentProduct.name}}</view>
        <view class="detail-price-row">
          <view class="detail-price">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{currentProduct.price}}</text>
            <text class="price-original" wx:if="{{currentProduct.originalPrice}}">¥{{currentProduct.originalPrice}}</text>
          </view>
          <view class="detail-sales">已售 {{currentProduct.sales}} 件</view>
        </view>
        <view class="detail-desc">{{currentProduct.desc}}</view>
      </view>
      
      <view class="detail-section" wx:if="{{currentProduct.specs && currentProduct.specs.length > 0}}">
        <text class="section-label">规格选择</text>
        <view class="specs-list">
          <view 
            class="spec-item {{selectedSpec === item ? 'selected' : ''}}"
            wx:for="{{currentProduct.specs}}"
            wx:key="*this"
            bindtap="selectSpec"
            data-spec="{{item}}"
          >{{item}}</view>
        </view>
      </view>
      
      <view class="detail-section">
        <text class="section-label">商品详情</text>
        <view class="detail-content-text">{{currentProduct.content}}</view>
      </view>
    </scroll-view>
    
    <view class="detail-footer">
      <view class="footer-left">
        <view class="footer-icon-btn" bindtap="toggleFavorite">
          <t-icon name="{{isFavorite ? 'heart-filled' : 'heart'}}" size="44rpx" color="{{isFavorite ? '#ff4d4f' : '#666'}}" />
          <text>收藏</text>
        </view>
        <view class="footer-icon-btn" bindtap="shareProduct">
          <t-icon name="share" size="44rpx" color="#666" />
          <text>分享</text>
        </view>
      </view>
      <view class="footer-right">
        <button class="action-btn cart" bindtap="addToCart">加入购物车</button>
        <button class="action-btn buy" bindtap="buyNow">立即购买</button>
      </view>
    </view>
  </view>
</t-popup>

<!-- 排序选项 -->
<t-action-sheet visible="{{showSortSheet}}" items="{{sortOptions}}" bind:selected="onSortSelect" bind:cancel="hideSortOptions" />
