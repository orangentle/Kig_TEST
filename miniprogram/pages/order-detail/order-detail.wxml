<!--order-detail.wxml-->
<view class="container">
  <!-- 顶部 -->
  <view class="page-header">
    <view class="nav-bar">
      <view class="back-button" bindtap="onBack">
        <t-icon name="chevron-left" size="40rpx" color="#c25a1a" />
      </view>
      <text class="page-title">订单详情</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 订单不存在 -->
  <view class="not-found" wx:if="{{notFound}}">
    <text class="not-found-title">咦,这只订单跑掉啦~</text>
    <text class="not-found-tip">订单号要再核对一下哦</text>
  </view>

  <!-- 订单信息卡 -->
  <view class="order-info-card" wx:if="{{!notFound}}">
    <view class="card-head">
      <view class="role-block">
        <text class="role-name">{{order.roleName}}</text>
        <text class="role-sub" wx:if="{{order.queueNumber}}">{{order.queueNumber}}</text>
      </view>
      <view class="status-pill {{order.status === 'urgent' ? 'pill-urgent' : order.status === 'completed' ? 'pill-done' : order.status === 'rejected' ? 'pill-rejected' : order.status === 'pending' ? 'pill-pending' : 'pill-normal'}}">
        {{order.status === 'urgent' ? '加急' : order.status === 'completed' ? '已完成' : order.status === 'rejected' ? '已驳回' : order.status === 'pending' ? '待审核' : '进行中'}}
      </view>
    </view>

    <view class="review-banner banner-pending" wx:if="{{order.status === 'pending'}}">
      <t-icon name="time" size="32rpx" color="#c25a1a" />
      <text>客服正在审核您的订单信息，请耐心等待</text>
    </view>
    <view class="review-banner banner-rejected" wx:if="{{order.status === 'rejected'}}">
      <t-icon name="error-circle" size="32rpx" color="#cf1322" />
      <view class="banner-body">
        <text class="banner-title">订单已被驳回</text>
        <text class="banner-remark" wx:if="{{order.reviewInfo.reviewRemark}}">原因：{{order.reviewInfo.reviewRemark}}</text>
      </view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">淘宝订单号</text>
        <text class="info-value">{{order.tbOrderId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.orderTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">预期完成</text>
        <text class="info-value highlight">{{order.deadline}}</text>
      </view>
    </view>
  </view>

  <!-- 您提交的信息 -->
  <view class="submitted-card" wx:if="{{!notFound}}">
    <view class="card-title">
      <text class="title-text">您提交的信息</text>
    </view>

    <view class="submitted-row"><text class="sub-label">角色名称</text><text class="sub-value">{{order.roleName || '-'}}</text></view>
    <view class="submitted-row"><text class="sub-label">角色所属 IP</text><text class="sub-value">{{order.ip || '-'}}</text></view>

    <view class="sub-section" wx:if="{{order.bodyMeasurements}}">
      <text class="sub-section-title">身材数据</text>
      <view class="sub-grid">
        <view class="sub-grid-item"><text class="sub-label">身高</text><text class="sub-value">{{order.bodyMeasurements.height || '-'}} cm</text></view>
        <view class="sub-grid-item"><text class="sub-label">体重</text><text class="sub-value">{{order.bodyMeasurements.weight || '-'}} kg</text></view>
        <view class="sub-grid-item"><text class="sub-label">头围</text><text class="sub-value">{{order.bodyMeasurements.headCircumference || '-'}} cm</text></view>
        <view class="sub-grid-item"><text class="sub-label">肩宽</text><text class="sub-value">{{order.bodyMeasurements.shoulderWidth || '-'}} cm</text></view>
      </view>
    </view>

    <view class="sub-section" wx:if="{{order.referenceImages && order.referenceImages.length}}">
      <text class="sub-section-title">角色参考图</text>
      <view class="sub-image-list">
        <image
          wx:for="{{order.referenceImages}}"
          wx:key="*this"
          class="sub-thumb"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-urls="{{order.referenceImages}}"
          data-current="{{item}}"
        />
      </view>
    </view>

    <view class="sub-section" wx:if="{{order.options && order.options.needReplaceFace && order.replaceFaceImages && order.replaceFaceImages.length}}">
      <text class="sub-section-title">替换脸（{{order.replaceFaceImages.length}} 张）</text>
      <view class="sub-image-list">
        <image
          wx:for="{{order.replaceFaceImages}}"
          wx:key="*this"
          class="sub-thumb"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-urls="{{order.replaceFaceImages}}"
          data-current="{{item}}"
        />
      </view>
    </view>

    <view class="sub-section">
      <text class="sub-section-title">定制选项</text>
      <view class="sub-tag-list">
        <view class="sub-tag {{order.options.needAccessory ? 'tag-on' : ''}}">配饰：{{order.options.needAccessory ? '需要' : '不需要'}}</view>
        <view class="sub-tag {{order.options.needReplaceFace ? 'tag-on' : ''}}">替换脸：{{order.options.needReplaceFace ? order.options.replaceFaceCount + ' 张' : '不需要'}}</view>
        <view class="sub-tag {{order.isUrgent ? 'tag-urgent' : ''}}">{{order.isUrgent ? '加急 (+¥1200)' : '常规工期'}}</view>
      </view>
    </view>

    <view class="sub-section" wx:if="{{order.remark}}">
      <text class="sub-section-title">备注</text>
      <text class="sub-remark">{{order.remark}}</text>
    </view>
  </view>

  <!-- 制作进度（审核通过后才显示） -->
  <view class="progress-card" wx:if="{{!notFound && order.status !== 'pending' && order.status !== 'rejected'}}">
    <view class="card-title">
      <text class="title-text">制作进度</text>
      <text class="title-pct">{{progressPercent}}%</text>
    </view>

    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>

    <view class="steps">
      <view
        class="step {{index <= currentStepIndex ? 'active' : ''}} {{index === currentStepIndex ? 'current' : ''}}"
        wx:for="{{steps}}"
        wx:key="index"
      >
        <view class="step-marker">
          <view class="dot"></view>
          <view class="line" wx:if="{{index < steps.length - 1}}"></view>
        </view>
        <view class="step-body">
          <text class="step-title">{{item.title}}</text>
          <text class="step-content">{{item.content}}</text>
        </view>
        <text class="step-tag" wx:if="{{index === currentStepIndex}}">进行中</text>
      </view>
    </view>
  </view>

  <!-- 客户信息（仅管理员可见） -->
  <view class="admin-info-card" wx:if="{{isAdmin && !notFound}}">
    <view class="card-title">
      <text class="title-text">客户信息</text>
      <text class="admin-badge">管理员可见</text>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">客户称呼</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.customerName ? 'empty' : ''}}">{{order.customerName || '未填'}}</text>
      </view>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">微信昵称</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.userInfo.nickName ? 'empty' : ''}}">{{order.userInfo.nickName || '未授权'}}</text>
      </view>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">淘宝旺旺</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.userInfo.taobaoName ? 'empty' : ''}}">{{order.userInfo.taobaoName || '未填'}}</text>
        <view wx:if="{{order.userInfo.taobaoName}}" class="admin-copy-btn" data-text="{{order.userInfo.taobaoName}}" catchtap="onAdminCopy">复制</view>
      </view>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">QQ</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.userInfo.qq ? 'empty' : ''}}">{{order.userInfo.qq || '未填'}}</text>
        <view wx:if="{{order.userInfo.qq}}" class="admin-copy-btn" data-text="{{order.userInfo.qq}}" catchtap="onAdminCopy">复制</view>
      </view>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">手机号</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.userInfo.phone ? 'empty' : ''}}">{{order.userInfo.phone || '未填'}}</text>
        <view wx:if="{{order.userInfo.phone}}" class="admin-copy-btn" data-text="{{order.userInfo.phone}}" catchtap="onAdminCall">拨打</view>
        <view wx:if="{{order.userInfo.phone}}" class="admin-copy-btn" data-text="{{order.userInfo.phone}}" catchtap="onAdminCopy">复制</view>
      </view>
    </view>

    <view class="admin-row">
      <text class="admin-row-label">淘宝订单号</text>
      <view class="admin-row-actions">
        <text class="admin-row-value">{{order.tbOrderId}}</text>
        <view class="admin-copy-btn" data-text="{{order.tbOrderId}}" catchtap="onAdminCopy">复制</view>
      </view>
    </view>

    <view class="admin-row" wx:if="{{order.reviewInfo && order.reviewInfo.reviewTime}}">
      <text class="admin-row-label">审核备注</text>
      <view class="admin-row-actions">
        <text class="admin-row-value {{!order.reviewInfo.reviewRemark ? 'empty' : ''}}">{{order.reviewInfo.reviewRemark || '无'}}</text>
      </view>
    </view>
  </view>

</view>
