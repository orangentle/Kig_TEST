/* order-detail.wxss — 北欧极简 · 暖色克制 */
.container {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.page-header {
  padding: 0 24rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
  background: var(--color-bg);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  position: relative;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-button:active {
  background: var(--color-primary-bg);
}

.page-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 4rpx;
  font-family: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  pointer-events: none;
}

.nav-placeholder {
  margin-left: auto;
  width: 64rpx;
}

/* 通用卡片样式 */
.order-info-card,
.progress-card,
.admin-info-card,
.submitted-card {
  margin: 16rpx 24rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid var(--color-divider);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

/* 管理员可见的客户信息卡 */
.admin-info-card { border-left: 6rpx solid var(--color-primary); }
.admin-badge {
  display: inline-block;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  letter-spacing: 1rpx;
}
.admin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--color-divider);
}
.admin-row:last-child { border-bottom: none; }
.admin-row-label { font-size: 26rpx; color: var(--color-text-secondary); }
.admin-row-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  user-select: text;
}
.admin-row-value.empty { color: var(--color-text-tertiary); font-weight: 400; }
.admin-row-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.admin-copy-btn {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.admin-copy-btn:active { opacity: 0.7; }

/* 订单信息卡 */
.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--color-divider);
  margin-bottom: 20rpx;
}

.role-block {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.role-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.role-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

.status-pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  margin-left: 16rpx;
}

.pill-normal {
  background: var(--color-primary-bg);
  color: var(--color-deco-warm);
  border: 1rpx solid #ffd8a8;
}

.pill-urgent {
  background: var(--color-primary);
  color: #fff;
  border: 1rpx solid var(--color-primary);
}

.pill-done {
  background: #eef7ee;
  color: var(--color-success);
  border: 1rpx solid #c8e6c8;
}

.info-grid {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.info-value.highlight {
  color: var(--color-deco-warm);
  font-weight: 600;
}

/* 进度卡 */
.card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 3rpx;
  padding-left: 16rpx;
  position: relative;
}

.title-text::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}

.title-pct {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 1rpx;
  font-family: "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #f5efe4;
  border-radius: 999rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  border-radius: 999rpx;
  transition: width 0.4s ease;
}

/* 步骤列表 */
.steps {
  display: flex;
  flex-direction: column;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  position: relative;
}

.step-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 32rpx;
  flex-shrink: 0;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid var(--color-divider);
  margin-top: 8rpx;
  transition: all 0.3s;
  box-sizing: border-box;
}

.step.active .dot {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.step.current .dot {
  box-shadow: 0 0 0 8rpx rgba(255, 144, 32, 0.15);
  width: 24rpx;
  height: 24rpx;
  margin-top: 6rpx;
}

.line {
  flex: 1;
  width: 2rpx;
  min-height: 42rpx;
  background: var(--color-divider);
  margin-top: 6rpx;
}

.step.active .line {
  background: #ffd8a8;
}

.step-body {
  flex: 1;
  padding-bottom: 28rpx;
}

.step-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
  transition: color 0.3s;
}

.step.active .step-title {
  color: var(--color-text);
  font-weight: 600;
}

.step.current .step-title {
  color: var(--color-deco-warm);
}

.step-content {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.step.active .step-content {
  color: var(--color-text-secondary);
}

.step-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  border: 1rpx solid #ffd8a8;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  align-self: flex-start;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 订单不存在 */
.not-found {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.not-found-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.not-found-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

/* ====== 状态 pill 扩展 + 审核横幅 ====== */
.pill-pending { background: var(--color-primary-bg); color: var(--color-deco-warm); }
.pill-rejected { background: #fff1f0; color: var(--color-danger); }
.pill-canceled { background: #f5f5f5; color: #888; }

.review-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 20rpx 28rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.banner-pending { background: var(--color-primary-bg); color: var(--color-deco-warm); border: 1rpx solid #ffd8a8; }
.banner-rejected { background: #fff1f0; color: var(--color-danger); border: 1rpx solid #ffccc7; }
.banner-canceled { background: #f5f5f5; color: #888; border: 1rpx solid #e5e5e5; }
.banner-body { display: flex; flex-direction: column; flex: 1; }
.banner-title { font-weight: 600; margin-bottom: 4rpx; }

.cancel-row {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 28rpx 0;
}
.cancel-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: var(--color-danger);
  font-size: 24rpx;
  border: 1rpx solid #ffccc7;
}
.cancel-btn:active { opacity: 0.7; }
.banner-remark { font-size: 22rpx; opacity: 0.85; }

/* ====== 您提交的信息 卡片 ====== */
.submitted-card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(168, 90, 21, 0.06);
  border: 1rpx solid var(--color-divider);
}

.submitted-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
}

.sub-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  margin-right: 14rpx;
}

.sub-value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.sub-section { margin-top: 22rpx; }
.sub-section-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.sub-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--color-bg);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}
.sub-grid-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx;
}
.sub-grid-item .sub-value { font-size: 24rpx; }

.sub-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.sub-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: var(--color-primary-bg);
  border: 1rpx solid var(--color-divider);
}

.sub-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sub-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-bg-warm);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-divider);
}
.sub-tag.tag-on { background: var(--color-primary-bg); color: var(--color-deco-warm); border-color: #f0d6a8; }
.sub-tag.tag-urgent { background: #fff1f0; color: var(--color-danger); border-color: #ffccc7; }

.sub-remark {
  display: block;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
  background: var(--color-bg);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

/* ====== 编辑订单入口 ====== */
.admin-edit-row {
  display: flex;
  justify-content: flex-end;
  margin: -8rpx 0 16rpx;
}
.admin-edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 144, 32, 0.25);
}
.admin-edit-btn:active { opacity: 0.85; }

/* ====== 编辑订单弹窗（复用 admin 表单视觉） ====== */
.form-popup {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}
.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.form-title { font-size: 32rpx; font-weight: 700; color: var(--color-text); }
.form-body {
  padding: 24rpx 32rpx;
  max-height: 70vh;
}
.form-section {
  margin-bottom: 28rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.form-section:last-child { border-bottom: none; }
.form-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--color-primary);
  line-height: 1.2;
}
.form-row-2 { display: flex; gap: 20rpx; }
.form-col { flex: 1; }
.form-item { margin-bottom: 24rpx; }
.form-row-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}
.form-label-inline { font-size: 28rpx; color: var(--color-text); }
.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
}
.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.img-thumb { width: 100%; height: 100%; display: block; }
.img-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--color-divider);
  border-radius: 12rpx;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.upload-icon { font-size: 56rpx; line-height: 1; color: var(--color-text-tertiary); }
.form-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
}
.form-footer t-button { flex: 1; }

