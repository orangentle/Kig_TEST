/* order-detail.wxss — 北欧极简 · 暖色克制 */
.container {
  min-height: 100vh;
  background: #fdf8f0;
  display: flex;
  flex-direction: column;
  padding-bottom: 60rpx;
}

/* 顶部导航 */
.page-header {
  padding: 0 24rpx;
  padding-top: env(safe-area-inset-top);
  background: #fdf8f0;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 96rpx;
  position: relative;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-button:active {
  background: #fff4e6;
}

.page-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #3a2410;
  letter-spacing: 4rpx;
  font-family: "Hannotate SC", "Yuanti SC", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  pointer-events: none;
}

.nav-placeholder {
  margin-left: auto;
  width: 64rpx;
}

/* 通用卡片样式 */
.order-info-card,
.progress-card,
.admin-info-card,
.submitted-card {
  margin: 16rpx 24rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #f0e6d6;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 90, 21, 0.04);
}

/* 管理员可见的客户信息卡 */
.admin-info-card { border-left: 6rpx solid #ff8800; }
.admin-badge {
  display: inline-block;
  background: #fff7e6;
  color: #ff8800;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  letter-spacing: 1rpx;
}
.admin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f5ebd9;
}
.admin-row:last-child { border-bottom: none; }
.admin-row-label { font-size: 26rpx; color: #998878; }
.admin-row-value {
  font-size: 28rpx;
  color: #4a3520;
  font-weight: 500;
  user-select: text;
}
.admin-row-value.empty { color: #c8b89a; font-weight: 400; }
.admin-row-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.admin-copy-btn {
  background: #fff7e6;
  color: #ff8800;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.admin-copy-btn:active { opacity: 0.7; }

/* 订单信息卡 */
.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #f0e6d6;
  margin-bottom: 20rpx;
}

.role-block {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.role-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3a2410;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.role-sub {
  font-size: 22rpx;
  color: #a08060;
  letter-spacing: 2rpx;
}

.status-pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  margin-left: 16rpx;
}

.pill-normal {
  background: #fff4e6;
  color: #c25a1a;
  border: 1rpx solid #ffd8a8;
}

.pill-urgent {
  background: #ff9020;
  color: #fff;
  border: 1rpx solid #ff9020;
}

.pill-done {
  background: #eef7ee;
  color: #4a8a4a;
  border: 1rpx solid #c8e6c8;
}

.info-grid {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  color: #a08060;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 28rpx;
  color: #3a2410;
  font-weight: 500;
}

.info-value.highlight {
  color: #c25a1a;
  font-weight: 600;
}

/* 进度卡 */
.card-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a2410;
  letter-spacing: 3rpx;
  padding-left: 16rpx;
  position: relative;
}

.title-text::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #ff9020;
}

.title-pct {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff9020;
  letter-spacing: 1rpx;
  font-family: "Hannotate SC", "Yuanti SC", "PingFang SC", sans-serif;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #f5efe4;
  border-radius: 999rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #ff9020, #ffc266);
  border-radius: 999rpx;
  transition: width 0.4s ease;
}

/* 步骤列表 */
.steps {
  display: flex;
  flex-direction: column;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  position: relative;
}

.step-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 32rpx;
  flex-shrink: 0;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #e8dcc8;
  margin-top: 8rpx;
  transition: all 0.3s;
  box-sizing: border-box;
}

.step.active .dot {
  border-color: #ff9020;
  background: #ff9020;
}

.step.current .dot {
  box-shadow: 0 0 0 8rpx rgba(255, 144, 32, 0.15);
  width: 24rpx;
  height: 24rpx;
  margin-top: 6rpx;
}

.line {
  flex: 1;
  width: 2rpx;
  min-height: 42rpx;
  background: #f0e6d6;
  margin-top: 6rpx;
}

.step.active .line {
  background: #ffd8a8;
}

.step-body {
  flex: 1;
  padding-bottom: 28rpx;
}

.step-title {
  display: block;
  font-size: 28rpx;
  color: #a08060;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
  transition: color 0.3s;
}

.step.active .step-title {
  color: #3a2410;
  font-weight: 600;
}

.step.current .step-title {
  color: #c25a1a;
}

.step-content {
  display: block;
  font-size: 22rpx;
  color: #c8b09a;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.step.active .step-content {
  color: #a08060;
}

.step-tag {
  font-size: 20rpx;
  color: #ff9020;
  background: #fff4e6;
  border: 1rpx solid #ffd8a8;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  align-self: flex-start;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 订单不存在 */
.not-found {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.not-found-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a2410;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.not-found-tip {
  font-size: 24rpx;
  color: #a08060;
  letter-spacing: 1rpx;
}

/* ====== 状态 pill 扩展 + 审核横幅 ====== */
.pill-pending { background: #fff4e6; color: #c25a1a; }
.pill-rejected { background: #fff1f0; color: #cf1322; }

.review-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 20rpx 28rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.banner-pending { background: #fff4e6; color: #c25a1a; border: 1rpx solid #ffd8a8; }
.banner-rejected { background: #fff1f0; color: #cf1322; border: 1rpx solid #ffccc7; }
.banner-body { display: flex; flex-direction: column; flex: 1; }
.banner-title { font-weight: 600; margin-bottom: 4rpx; }
.banner-remark { font-size: 22rpx; opacity: 0.85; }

/* ====== 您提交的信息 卡片 ====== */
.submitted-card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(168, 90, 21, 0.06);
  border: 1rpx solid #f0e6d6;
}

.submitted-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
}

.sub-label {
  font-size: 24rpx;
  color: #a08060;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.sub-value {
  font-size: 26rpx;
  color: #3a2410;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.sub-section { margin-top: 22rpx; }
.sub-section-title {
  display: block;
  font-size: 24rpx;
  color: #a08060;
  margin-bottom: 12rpx;
}

.sub-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fdf8f0;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}
.sub-grid-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx;
}
.sub-grid-item .sub-value { font-size: 24rpx; }

.sub-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.sub-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #fdf3e3;
  border: 1rpx solid #f0e0c4;
}

.sub-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sub-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f7f3eb;
  color: #6b5840;
  border: 1rpx solid #f0e6d6;
}
.sub-tag.tag-on { background: #fdf3e3; color: #c25a1a; border-color: #f0d6a8; }
.sub-tag.tag-urgent { background: #fff1f0; color: #cf1322; border-color: #ffccc7; }

.sub-remark {
  display: block;
  font-size: 26rpx;
  color: #3a2410;
  line-height: 1.6;
  background: #fdf8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}
