/**app.wxss**/
page {
  /* ===== 设计令牌 · 蜂蜜烤橘 ===== */
  /* 品牌色 */
  --color-primary: #FF8C3A;
  --color-primary-light: #FFB070;
  --color-primary-dark: #E8722A;
  --color-primary-bg: #FFF1DD;
  --color-accent: #F2B441;

  /* 文字 */
  --color-text: #2E1B0A;
  --color-text-secondary: #6B4F38;
  --color-text-tertiary: #A88971;
  --color-text-placeholder: #C9B299;
  --color-text-on-primary: #FFFFFF;

  /* 背景 */
  --color-bg: #FFF9EE;
  --color-bg-admin: #FAF6EE;
  --color-bg-warm: #FFF1DD;
  --color-card: #FFFFFF;
  --color-divider: #F4E4CC;

  /* 状态 */
  --color-success: #5BAE6A;
  --color-warning: #F2B441;
  --color-danger:  #E07458;
  --color-info:    #6B9CC9;

  /* 装饰 */
  --color-deco-warm: #C25A1A;
  --color-deco-deep: #4A2810;
  --color-deco-soft: #FFE9C2;

  /* gathering 子模块（主色变体） */
  --color-gathering-1: #FF8C3A;
  --color-gathering-2: #E8722A;
  --color-gathering-3: #F2B441;

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;

  /* 阴影（暖色统一） */
  --shadow-sm: 0 2rpx 8rpx rgba(184, 110, 40, 0.06);
  --shadow-md: 0 6rpx 24rpx rgba(184, 110, 40, 0.10);
  --shadow-lg: 0 12rpx 36rpx rgba(255, 140, 58, 0.20);

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;

  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.page-container {
  padding: 24rpx;
}

/* 卡片基础样式 */
.card {
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 通用布局 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-between { justify-content: space-between; }
.flex-center { justify-content: center; align-items: center; }
.flex-grow { flex-grow: 1; }

/* 文字 */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-gray { color: var(--color-text-tertiary); }
.text-center { text-align: center; }

.title-xl { font-size: 40rpx; font-weight: 700; color: var(--color-text); letter-spacing: 0.5rpx; }
.title-lg { font-size: 34rpx; font-weight: 600; color: var(--color-text); }
.title-md { font-size: 30rpx; font-weight: 600; color: var(--color-text); }
.text-caption { font-size: 24rpx; color: var(--color-text-tertiary); }

/* 间距 */
.mt-small { margin-top: 16rpx; }
.mt-medium { margin-top: 24rpx; }
.mt-large { margin-top: 32rpx; }
.mb-small { margin-bottom: 16rpx; }
.mb-medium { margin-bottom: 24rpx; }
.mb-large { margin-bottom: 32rpx; }

/* 主题渐变 */
.gradient-bg {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
}

/* 圆角 */
.rounded-full { border-radius: var(--radius-pill); }
.rounded-lg { border-radius: var(--radius-md); }

/* 头部 */
.header {
  padding: 36rpx 32rpx 32rpx;
  background: var(--color-card);
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.header-gradient {
  padding: 48rpx 32rpx 56rpx;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 60%, var(--color-primary-light) 100%);
  border-radius: 0 0 36rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.header-gradient::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.header-gradient::after {
  content: "";
  position: absolute;
  bottom: -120rpx;
  left: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

/* 主按钮 */
.primary-button {
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-light) 100%) !important;
  color: #fff !important;
  font-weight: 600 !important;
  box-shadow: 0 8rpx 20rpx rgba(232, 114, 42, 0.28) !important;
  border: none !important;
}

/* 区段标题 */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
}

.section-title-row .title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  position: relative;
  padding-left: 20rpx;
}

.section-title-row .title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
}

.section-title-row .more {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.status-urgent { background-color: rgba(224, 116, 88, 0.15); color: var(--color-danger); }
.status-normal { background-color: var(--color-primary-bg); color: var(--color-primary-dark); }
.status-soon { background-color: rgba(242, 180, 65, 0.18); color: #B8861E; }
.status-completed { background-color: rgba(91, 174, 106, 0.15); color: var(--color-success); }
.status-pending { background-color: rgba(242, 180, 65, 0.18); color: #B8861E; }
.status-approved { background-color: rgba(107, 156, 201, 0.15); color: var(--color-info); }
.status-rejected { background-color: rgba(224, 116, 88, 0.15); color: var(--color-danger); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
}

.empty-image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  opacity: 0.45;
  border-radius: 50%;
}

.empty-text {
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: var(--color-divider);
  margin: 16rpx 0;
}
